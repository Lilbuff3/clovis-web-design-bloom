{
  "name": "clovis-web-design-bloom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "sync:discovery": "node -e \"import('./src/lib/discovery.ts').then(m => m.syncDiscoveryManifests())\"",
    "build": "npm run sync:discovery && astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node tests/site-check.test.mjs && node tests/verify-e2e.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.1",
    "astro": "^5.4.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
