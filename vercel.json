{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/services/web-design-clovis/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/work/kidney-specialist-inc/",
      "destination": "/#work",
      "statusCode": 301
    },
    {
      "source": "/work/big-bros-dumpster/",
      "destination": "/#work",
      "statusCode": 301
    },
    {
      "source": "/work/",
      "destination": "/#work",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
