---
import { PHONE_TEL } from '../lib/data';
import Icon from './Icon.astro';
---

<aside class="fixed inset-x-0 bottom-0 z-40 block md:hidden bg-cream/95 backdrop-blur-md border-t border-ink/10 px-4 py-2.5 shadow-[0_-10px_25px_-5px_rgba(30,43,35,0.15)]">
  <div class="flex items-center justify-between gap-2 max-w-lg mx-auto">
    <!-- Availability indicator -->
    <div class="hidden min-w-0 items-center gap-1.5 font-mono text-[11px] text-ink/75 min-[430px]:flex">
      <span class="relative flex h-2 w-2 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-leaf opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-leaf"></span>
      </span>
      <span class="truncate">Texts go straight to Adam</span>
    </div>

    <!-- Actions -->
    <div class="flex flex-1 items-center gap-2">
      <a
        href={`tel:${PHONE_TEL}`}
        class="flex-1 min-h-[48px] inline-flex items-center justify-center gap-1.5 rounded-full bg-ink/10 px-4 py-3 font-mono text-[13px] font-semibold text-ink transition active:scale-95 hover:bg-ink/20"
        aria-label="Call Adam"
      >
        <Icon name="phone" /> Call
      </a>
      <a
        href={`sms:${PHONE_TEL}`}
        class="flex-1 min-h-[48px] inline-flex items-center justify-center gap-1.5 rounded-full bg-persimmon-deep px-4 py-3 font-mono text-[13px] font-semibold text-cream shadow-md transition active:scale-95 hover:bg-ink"
        aria-label="Text Adam"
      >
        <Icon name="text" /> Text
      </a>
    </div>
  </div>
</aside>
