---
import { PHONE_DISPLAY, PHONE_TEL, smsTo } from '../lib/data';
import { LeadLeakAudit } from './LeadLeakAudit';
import Icon from './Icon.astro';
---

<aside class="fixed inset-x-0 bottom-0 z-40 block md:hidden bg-[#151515]/95 backdrop-blur-xl border-t border-white/15 px-4 py-2.5 text-white shadow-[0_-10px_30px_rgba(0,0,0,0.45)]">
  <div class="flex items-center justify-between gap-2 max-w-lg mx-auto">
    <!-- Availability indicator -->
    <div class="hidden min-w-0 items-center gap-1.5 font-mono text-[11px] text-white/80 min-[430px]:flex">
      <span class="relative flex h-2 w-2 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00FF08] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-[#00FF08]"></span>
      </span>
      <span class="truncate">Texts come straight to me</span>
    </div>

    <!-- Actions -->
    <div class="flex flex-1 items-center gap-2">
      <a
        href={`tel:${PHONE_TEL}`}
        class="flex-1 min-h-[48px] inline-flex items-center justify-center gap-1.5 rounded-[8px] border border-white/25 bg-[#1E1E1E] px-4 py-3 font-mono text-[13px] font-semibold text-white transition active:scale-95 hover:bg-white/10"
        aria-label="Call Adam"
      >
        <Icon name="phone" /> Call
      </a>
      <a
        href={smsTo("Hi Adam, I'm on your website and have a quick question about getting a site built.")}
        class="flex-1 min-h-[48px] inline-flex items-center justify-center gap-1.5 rounded-[8px] bg-white px-4 py-3 font-mono text-[13px] font-semibold text-[#070707] shadow-md transition active:scale-95 hover:bg-[#E03E10] hover:text-white"
        aria-label="Text Adam"
      >
        <Icon name="text" /> Text
      </a>
      <button
        type="button"
        data-audit="true"
        id="audit-drawer-btn"
        class="min-h-[48px] inline-flex items-center justify-center gap-1 rounded-[8px] border border-white/25 bg-[#1E1E1E] px-3.5 py-3 font-mono text-[12px] font-medium text-white transition active:scale-95 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF4D1C] focus-visible:ring-offset-2"
      >
        AI check
      </button>
    </div>
  </div>
</aside>

<!-- Slide-up Instant Audit Drawer Dialog -->
<dialog id="audit-modal" class="fixed inset-x-0 bottom-0 top-auto z-50 m-0 w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-t-[16px] border-t border-white/15 bg-[#151515] p-5 text-white sm:p-6 shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm">
  <div class="flex items-start justify-between">
    <div>
      <h2 class="font-sans text-2xl font-medium tracking-[-0.035em] text-white">Free AI check</h2>
    </div>
    <button type="button" id="close-audit-modal" class="min-h-[48px] min-w-[48px] inline-flex items-center justify-center rounded-[8px] border border-white/15 bg-[#1E1E1E] text-white/80 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF4D1C] focus-visible:ring-offset-2" aria-label="Close dialog">
      ✕
    </button>
  </div>
  <div class="mt-4">
    <LeadLeakAudit compact client:idle />
  </div>
  <div class="mt-4 border-t border-white/10 pt-3 text-center">
    <a
      href={smsTo("Hi Adam, could you take a quick look at my website?")}
      class="text-xs font-mono text-white/80 underline hover:text-[#FF4D1C]"
    >
      Or text me directly at {PHONE_DISPLAY}
    </a>
  </div>
</dialog>

<script>
  const btn = document.getElementById('audit-drawer-btn');
  const modal = document.getElementById('audit-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('close-audit-modal');

  btn?.addEventListener('click', () => {
    modal?.showModal();
  });
  closeBtn?.addEventListener('click', () => {
    modal?.close();
  });
  modal?.addEventListener('click', (e) => {
    const rect = modal.getBoundingClientRect();
    const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
      rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
    if (!isInDialog) modal.close();
  });
</script>
