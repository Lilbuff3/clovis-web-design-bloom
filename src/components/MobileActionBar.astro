---
import { PHONE_DISPLAY, PHONE_TEL } from '../lib/data';
import { LeadLeakAudit } from './LeadLeakAudit';
---

<aside class="fixed inset-x-0 bottom-0 z-40 block md:hidden bg-cream/95 backdrop-blur-md border-t border-ink/10 px-4 py-2.5 shadow-[0_-10px_25px_-5px_rgba(30,43,35,0.15)]">
  <div class="flex items-center justify-between gap-2 max-w-lg mx-auto">
    <!-- Availability indicator -->
    <div class="hidden min-w-0 items-center gap-1.5 font-mono text-[11px] text-ink/75 min-[430px]:flex">
      <span class="relative flex h-2 w-2 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-leaf opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-leaf"></span>
      </span>
      <span class="truncate">Texts go straight to Adam</span>
    </div>

    <!-- Actions -->
    <div class="flex flex-1 items-center gap-2">
      <a
        href={`tel:${PHONE_TEL}`}
        class="flex-1 min-h-[48px] inline-flex items-center justify-center gap-1.5 rounded-full bg-ink/10 px-4 py-3 font-mono text-[13px] font-semibold text-ink transition active:scale-95 hover:bg-ink/20"
        aria-label="Call Adam"
      >
        <span>📞</span> Call
      </a>
      <a
        href={`sms:${PHONE_TEL}`}
        class="flex-1 min-h-[48px] inline-flex items-center justify-center gap-1.5 rounded-full bg-persimmon px-4 py-3 font-mono text-[13px] font-semibold text-cream shadow-md transition active:scale-95 hover:bg-persimmon-deep"
        aria-label="Text Adam"
      >
        <span>💬</span> Text
      </a>
      <button
        type="button"
        data-audit="true"
        id="audit-drawer-btn"
        class="min-h-[48px] inline-flex items-center justify-center gap-1 rounded-full border border-ink/20 bg-cream px-3.5 py-3 font-mono text-[12px] font-medium text-ink transition active:scale-95 hover:bg-ink/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-persimmon focus-visible:ring-offset-2"
      >
        AI check
      </button>
    </div>
  </div>
</aside>

<!-- Slide-up Instant Audit Drawer Dialog -->
<dialog id="audit-modal" class="fixed inset-x-0 bottom-0 top-auto z-50 m-0 w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-t-3xl border-t border-ink/15 bg-paper p-5 sm:p-6 shadow-2xl backdrop:bg-ink/50 backdrop:backdrop-blur-sm">
  <div class="flex items-start justify-between">
    <div>
      <h3 class="font-display text-2xl font-semibold text-ink">Free AI check</h3>
    </div>
    <button type="button" id="close-audit-modal" class="min-h-[44px] min-w-[44px] inline-flex items-center justify-center rounded-full text-ink/60 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2" aria-label="Close dialog">
      ✕
    </button>
  </div>
  <div class="mt-4">
    <LeadLeakAudit compact client:idle />
  </div>
  <div class="mt-4 border-t border-ink/10 pt-3 text-center">
    <a
      href={`sms:${PHONE_TEL}?body=${encodeURIComponent("Hi Adam, could you take a quick look at my website?")}`}
      class="text-xs font-mono text-ink/60 underline hover:text-persimmon"
    >
      Or text Adam directly ({PHONE_DISPLAY})
    </a>
  </div>
</dialog>

<script>
  const btn = document.getElementById('audit-drawer-btn');
  const modal = document.getElementById('audit-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('close-audit-modal');

  btn?.addEventListener('click', () => {
    modal?.showModal();
  });
  closeBtn?.addEventListener('click', () => {
    modal?.close();
  });
  modal?.addEventListener('click', (e) => {
    const rect = modal.getBoundingClientRect();
    const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
      rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
    if (!isInDialog) modal.close();
  });
</script>
