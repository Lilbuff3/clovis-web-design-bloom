---
import { PHONE_DISPLAY, PHONE_TEL, smsTo } from '../lib/data';
import { LeadLeakAudit } from './LeadLeakAudit';
import Icon from './Icon.astro';
---

<aside class="fixed inset-x-0 bottom-0 z-40 block md:hidden border-t border-[#141311]/12 bg-[#EAE6DF]/92 px-4 py-2.5 text-[#141311] shadow-[0_-10px_30px_rgba(20,19,17,0.08)] backdrop-blur-xl">
  <div class="mx-auto flex max-w-lg items-center justify-between gap-2">
    <!-- Availability indicator -->
    <div class="hidden min-w-0 items-center gap-1.5 text-[12px] font-medium text-[#141311] min-[430px]:flex">
      <span class="relative flex h-2 w-2 shrink-0">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#0B6E3F] opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-[#0B6E3F]"></span>
      </span>
      <span class="truncate">Texts come straight to me</span>
    </div>

    <!-- Actions -->
    <div class="flex flex-1 items-center gap-2">
      <a
        href={`tel:${PHONE_TEL}`}
        class="inline-flex min-h-[46px] flex-1 items-center justify-center gap-1.5 rounded-full border border-[#141311]/15 bg-[#F6F4EF] px-4 py-2.5 font-sans text-[13.5px] font-semibold text-[#141311] transition hover:bg-[#DFDBD2] active:scale-95"
        aria-label="Call me"
      >
        <Icon name="phone" /> Call
      </a>
      <a
        href={smsTo("Hi Adam, I'm on your website and have a quick question about getting a site built.")}
        class="inline-flex min-h-[46px] flex-1 items-center justify-center gap-1.5 rounded-full bg-[#002FA7] px-4 py-2.5 font-sans text-[13.5px] font-semibold text-[#F6F4EF] transition hover:bg-[#141311] active:scale-95"
        aria-label="Text me"
      >
        <Icon name="text" /> Text
      </a>
      <button
        type="button"
        data-audit="true"
        id="audit-drawer-btn"
        class="inline-flex min-h-[46px] items-center justify-center gap-1 rounded-full bg-[#DFDBD2] px-4 py-2.5 font-sans text-[13px] font-semibold text-[#141311] transition hover:bg-[#141311] hover:text-[#F6F4EF] active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#002FA7]"
      >
        AI check
      </button>
    </div>
  </div>
</aside>

<!-- Slide-up Instant Audit Drawer Dialog -->
<dialog id="audit-modal" closedby="any" aria-labelledby="audit-modal-title" class="fixed inset-x-0 bottom-0 top-auto z-50 m-0 max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-t-3xl border-t border-[#141311]/12 bg-[#EAE6DF] p-5 text-[#141311] shadow-2xl backdrop:bg-[#141311]/45 backdrop:backdrop-blur-sm sm:p-6">
  <div class="flex items-center justify-between border-b border-[#141311]/10 pb-3">
    <div>
      <h2 id="audit-modal-title" class="font-sans text-2xl font-semibold tracking-[-0.035em] text-[#141311]">Free AI check</h2>
    </div>
    <button type="button" id="close-audit-modal" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#F6F4EF] font-sans text-sm font-semibold text-[#141311] hover:bg-[#141311] hover:text-[#F6F4EF] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#002FA7]" aria-label="Close dialog">
      ✕
    </button>
  </div>
  <div class="mt-4">
    <LeadLeakAudit compact client:idle />
  </div>
  <div class="mt-4 border-t border-[#141311]/10 pt-3 text-center">
    <a
      href={smsTo("Hi Adam, could you take a quick look at my website?")}
      class="font-sans text-xs font-semibold text-[#141311] hover:text-[#002FA7] hover:underline"
    >
      Or text me directly at {PHONE_DISPLAY}
    </a>
  </div>
</dialog>

<script>
  const btn = document.getElementById('audit-drawer-btn');
  const modal = document.getElementById('audit-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('close-audit-modal');

  btn?.addEventListener('click', () => {
    modal?.showModal();
  });
  closeBtn?.addEventListener('click', () => {
    modal?.close();
  });
  // Fallback for browsers without native <dialog closedby="any"> support (e.g. Safari)
  if (modal && !('closedBy' in HTMLDialogElement.prototype)) {
    modal.addEventListener('click', (e) => {
      if (e.target !== modal) return;
      const rect = modal.getBoundingClientRect();
      const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
      if (!isInDialog) modal.close();
    });
  }
</script>
