---
// src/components/MedicalComparisonTable.astro
---

<div class="overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0">
  <table class="w-full min-w-[640px] text-left border-collapse border border-ink/10 bg-paper rounded-2xl shadow-sm overflow-hidden">
    <thead>
      <tr class="border-b border-ink/10 bg-ink/5">
        <th scope="col" class="p-4 md:p-5 font-mono text-xs uppercase tracking-wider text-ink/70 w-1/4">Operational Dimension</th>
        <th scope="col" class="p-4 md:p-5 font-mono text-xs uppercase tracking-wider text-ink/70 w-3/8">Contractor &amp; Home Services</th>
        <th scope="col" class="p-4 md:p-5 font-mono text-xs uppercase tracking-wider text-leaf font-semibold w-3/8">Medical Clinic &amp; Healthcare</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-ink/10 text-sm md:text-base leading-relaxed text-ink/85">
      <tr class="hover:bg-ink/[0.02] transition-colors">
        <th scope="row" class="p-4 md:p-5 font-medium text-ink font-display text-base md:text-lg align-top">
          Primary Goal
        </th>
        <td class="p-4 md:p-5 align-top text-ink/80">
          Make phone ring with paying leads; capture immediate emergency quotes and urgent repairs.
        </td>
        <td class="p-4 md:p-5 align-top font-medium text-ink">
          Reduce front-desk phone friction, deflect repetitive questions, and book qualified appointments through pre-screened intake.
        </td>
      </tr>
      <tr class="hover:bg-ink/[0.02] transition-colors">
        <th scope="row" class="p-4 md:p-5 font-medium text-ink font-display text-base md:text-lg align-top">
          Speed-to-Lead
        </th>
        <td class="p-4 md:p-5 align-top text-ink/80">
          Raw lead details (name, cell, address, job issue) texted directly to owner's phone in &lt;60s.
        </td>
        <td class="p-4 md:p-5 align-top font-medium text-ink">
          Generic alert to clinic staff ("New intake ready"); all patient health details stored behind an encrypted, BAA-secured HIPAA-compliant portal.
        </td>
      </tr>
      <tr class="hover:bg-ink/[0.02] transition-colors">
        <th scope="row" class="p-4 md:p-5 font-medium text-ink font-display text-base md:text-lg align-top">
          Data Storage
        </th>
        <td class="p-4 md:p-5 align-top text-ink/80">
          Standard CRM, Google Sheets, Airtable, Jobber, Housecall Pro, or webhook pipelines.
        </td>
        <td class="p-4 md:p-5 align-top font-medium text-ink">
          Certified EHR/EMR systems (AthenaHealth, Kareo, Epic) or BAA-signed HIPAA databases (Jotform HIPAA, FormDr); zero unencrypted spreadsheets.
        </td>
      </tr>
      <tr class="hover:bg-ink/[0.02] transition-colors">
        <th scope="row" class="p-4 md:p-5 font-medium text-ink font-display text-base md:text-lg align-top">
          Top Decision Factor
        </th>
        <td class="p-4 md:p-5 align-top text-ink/80">
          Upfront build cost, speed to deployment, lead volume, and immediate call-to-action conversion.
        </td>
        <td class="p-4 md:p-5 align-top font-medium text-ink">
          Total regulatory compliance (HIPAA, HITECH, CMIA, ADA Title III), doctor clinical reputation, patient confidentiality, and friction-free booking ease.
        </td>
      </tr>
      <tr class="hover:bg-ink/[0.02] transition-colors">
        <th scope="row" class="p-4 md:p-5 font-medium text-ink font-display text-base md:text-lg align-top">
          Price Sensitivity
        </th>
        <td class="p-4 md:p-5 align-top text-ink/80">
          Moderate ROI-focused budget ($1,500 starter to $2,500 local authority system).
        </td>
        <td class="p-4 md:p-5 align-top font-medium text-ink">
          Low price sensitivity ($5,000+ custom flagship systems) with substantial practice budgets prioritizing malpractice risk elimination and front-desk efficiency.
        </td>
      </tr>
    </tbody>
  </table>
</div>
