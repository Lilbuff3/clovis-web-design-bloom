---
import RootLayout from '../layouts/RootLayout.astro';
import { Nav } from '../components/Chrome';
import { Hero } from '../components/Hero';
import { LifecycleExplorer } from '../components/LifecycleExplorer';
import { Harvest } from '../components/Harvest';
import { Season, Compare } from '../components/Season';
import { Grower, Stand, FAQ } from '../components/Story';
import { LeadLeakAudit } from '../components/LeadLeakAudit';
import { Contact, Footer } from '../components/Contact';
import { faqs, hasOfferCatalog, industries, pageSchema, smsTo } from '../lib/data';

const agencyText = smsTo("Hi Adam! I'm with an agency and have a Figma project for you.");

const schema = pageSchema('/', {
  name: 'Brand positioning, custom web design, SEO & AI search marketing in Clovis, CA',
  serviceType: 'Brand positioning, web design, and search marketing',
  audience: 'Growth-minded businesses across industries',
  description: 'End-to-end brand positioning, sub-second custom websites, Google Maps SEO, AI search optimization (ChatGPT, Gemini, Claude, Perplexity), and lead attribution for businesses in Clovis, Fresno, and across the US.',
  offers: hasOfferCatalog.itemListElement,
}, faqs);
---

<RootLayout schema={schema} preloadImage="/images/hero.webp">
  <Nav client:load currentPath={Astro.url.pathname} />

  <main id="main" class="relative z-10 bg-[#EAE6DF] text-[#141311]">
    <Hero client:load />

    <section id="who" class="relative overflow-hidden border-t border-[#141311]/12 bg-[#DFDBD2]/55 px-5 py-10 text-[#141311] md:px-8 md:py-12">
      <span id="services" class="absolute -top-24 pointer-events-none" aria-hidden="true"></span>

      <div class="mx-auto max-w-7xl">
        <!-- Calm Editorial Section Header -->
        <div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
          <div class="max-w-2xl">
            <h2 class="font-sans text-[clamp(1.85rem,3.3vw,2.85rem)] font-semibold leading-[1.02] tracking-[-0.038em] text-[#141311]">
              Growth at every stage. Hire me for one channel or all five.
            </h2>
          </div>
          <div class="flex flex-wrap items-center gap-4 text-[14px] font-semibold">
            <a
              href="/services/"
              class="text-[#141311] transition-colors hover:text-[#002FA7]"
            >
              All 5 services →
            </a>
            <a
              href="/packages/"
              class="rounded-full bg-[#F6F4EF] px-4 py-2 text-[#141311] transition-colors hover:bg-[#141311] hover:text-[#F6F4EF]"
            >
              Modular packages →
            </a>
          </div>
        </div>

        <!-- Interactive 5-Stage Console (All 5 Stages Pre-Rendered in Static DOM) -->
        <LifecycleExplorer client:load />

        <!-- Smooth 4-Column Green-Space & Specialized Playbooks Strip -->
        <div class="mt-5 overflow-hidden rounded-2xl border border-[#141311]/12 bg-[#F6F4EF]">
          <div class="grid divide-y divide-[#141311]/10 md:grid-cols-2 lg:grid-cols-4 lg:divide-x lg:divide-y-0">
            <!-- Col 1: Cross-Sector Green Space Thesis + Collapsible 16-Industry Matrix -->
            <div class="flex flex-col justify-between bg-[#EAE6DF]/60 p-5">
              <div>
                <h3 class="font-sans text-[16px] font-semibold leading-snug tracking-[-0.02em] text-[#141311]">
                  We find green space, not just market share.
                </h3>
                <p class="mt-1.5 text-[13px] leading-relaxed text-[#4A4742]">
                  Cross-industry &lt;0.4s engineering and four-directory AI citation mechanics brought into your market first.
                </p>
              </div>
              <details class="mt-3 pt-2">
                <summary class="cursor-pointer text-[12.5px] font-semibold text-[#002FA7] hover:text-[#141311]">
                  16 industries served ↓
                </summary>
                <div class="mt-2.5 flex flex-wrap gap-1.5">
                  {industries.map((ind) => (
                    <span class="rounded-md bg-[#F6F4EF] px-2 py-0.5 text-[11.5px] font-medium text-[#141311]">
                      {ind}
                    </span>
                  ))}
                </div>
              </details>
            </div>

            <!-- Col 2: Playbook 01 -->
            <a
              href="/services/local-seo-fresno/"
              class="group flex flex-col justify-between p-5 transition-colors hover:bg-white"
            >
              <div>
                <div class="font-sans text-[16px] font-semibold leading-snug tracking-[-0.02em] text-[#141311]">
                  Search, Google Maps &amp; AI Marketing
                </div>
                <p class="mt-1.5 text-[13px] leading-relaxed text-[#4A4742]">
                  How Google Maps, ChatGPT, Gemini, Claude, and Siri choose who to recommend first.
                </p>
              </div>
              <span class="mt-3 inline-flex items-center gap-1 text-[13px] font-semibold text-[#002FA7] group-hover:translate-x-0.5 transition-transform">
                Search &amp; GEO Playbook <span aria-hidden="true">→</span>
              </span>
            </a>

            <!-- Col 3: Playbook 02 -->
            <a
              href="/services/medical-web-design/"
              class="group flex flex-col justify-between p-5 transition-colors hover:bg-white"
            >
              <div>
                <div class="font-sans text-[16px] font-semibold leading-snug tracking-[-0.02em] text-[#141311]">
                  Healthcare &amp; Medical Practice Web Design
                </div>
                <p class="mt-1.5 text-[13px] leading-relaxed text-[#4A4742]">
                  Privacy-safe architecture, physician referral routing, and WCAG 2.1 AA patient accessibility.
                </p>
              </div>
              <span class="mt-3 inline-flex items-center gap-1 text-[13px] font-semibold text-[#002FA7] group-hover:translate-x-0.5 transition-transform">
                Medical Architecture <span aria-hidden="true">→</span>
              </span>
            </a>

            <!-- Col 4: Playbook 03 -->
            <a
              href="/services/contractor-websites/"
              class="group flex flex-col justify-between p-5 transition-colors hover:bg-white"
            >
              <div>
                <div class="font-sans text-[16px] font-semibold leading-snug tracking-[-0.02em] text-[#141311]">
                  Contractor &amp; Commercial Fleet Websites
                </div>
                <p class="mt-1.5 text-[13px] leading-relaxed text-[#4A4742]">
                  Outrank national lead brokers with sub-second service area pages and direct call/SMS dispatch.
                </p>
              </div>
              <span class="mt-3 inline-flex items-center gap-1 text-[13px] font-semibold text-[#002FA7] group-hover:translate-x-0.5 transition-transform">
                Contractor &amp; Fleet Builds <span aria-hidden="true">→</span>
              </span>
            </a>
          </div>

          <div class="flex flex-col justify-between gap-2 border-t border-[#141311]/10 bg-[#EAE6DF]/40 px-5 py-2.5 text-[13px] text-[#4A4742] sm:flex-row sm:items-center">
            <span>
              <strong class="font-semibold text-[#141311]">Agencies &amp; creative directors:</strong> White-label builds from your Figma files in Astro, React, and TypeScript.
            </span>
            <a
              href={agencyText}
              class="shrink-0 font-semibold text-[#002FA7] hover:underline"
            >
              Send a Figma link →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Compact Horizontal Live AI Citation Bar -->
    <section id="check" class="relative overflow-hidden border-t border-[#141311]/12 bg-[#EAE6DF] px-5 py-8 text-[#141311] md:px-8 md:py-10">
      <div class="mx-auto max-w-7xl">
        <LeadLeakAudit client:visible />
      </div>
    </section>

    <!-- Tabbed Client Work Specimen Switcher (Both Case Studies in Static DOM) -->
    <Harvest client:visible />

    <!-- Side-by-Side 12-Column Architectural Row: 4-Stage Process (#season) + Agency Comparison Table (#compare) -->
    <div class="border-t border-[#141311]/12 bg-[#DFDBD2]/45">
      <div class="mx-auto grid max-w-7xl lg:grid-cols-12">
        <Season client:visible />
        <Compare client:visible />
      </div>
    </div>

    <!-- Side-by-Side 12-Column Architectural Row: Founder Guarantee (#grower) + Common Questions (#faq) -->
    <div class="border-t border-[#141311]/12 bg-[#EAE6DF]">
      <div class="mx-auto grid max-w-7xl lg:grid-cols-12">
        <Grower client:visible />
        <FAQ client:visible />
      </div>
    </div>

    <!-- Single-Viewport 12-Column Modular Scope Configurator (#stand) -->
    <Stand client:visible />

    <Contact client:visible />
  </main>

  <Footer />
</RootLayout>
