---
import RootLayout from '../layouts/RootLayout.astro';
import { Nav } from '../components/Chrome';
import { Hero } from '../components/Hero';
import { Harvest } from '../components/Harvest';
import { Season, Compare } from '../components/Season';
import { Grower, Stand, FAQ } from '../components/Story';
import { LeadLeakAudit } from '../components/LeadLeakAudit';
import { Contact, Footer } from '../components/Contact';

const audiences = [
  {
    href: '/services/medical-web-design/',
    who: 'Doctors · Dentists · Clinics · Law & accounting',
    title: 'Medical & professional offices',
    line: 'What I build for practices where trust, privacy and referrals matter most.',
    tint: 'bg-sky',
    cta: 'See medical sites',
  },
  {
    href: '/services/contractor-websites/',
    who: 'Roofers · HVAC · Plumbers · Dumpster rentals',
    title: 'Local businesses & contractors',
    line: 'What I build for businesses that need more calls.',
    tint: 'bg-blush',
    cta: 'See contractor sites',
  },
];
---

<RootLayout>
  <Nav client:load />

  <main id="main" class="relative z-10 rounded-b-[40px] shadow-[0_40px_60px_-30px_rgba(30,43,35,.35)] md:rounded-b-[72px] bg-paper">
    <Hero client:load />
    <Harvest client:visible />
    <section id="who" class="px-5 py-14 md:px-8 md:py-20">
      <div class="mx-auto max-w-7xl">
        <h2 class="font-display h-section">
          <span class="line-mask"><span>Pick your kind</span></span>
          <span class="line-mask" style="--d: 120ms"><span>of business.</span></span>
        </h2>
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {audiences.map((a, i) => (
            <a
              href={a.href}
              class={`reveal group flex flex-col rounded-[28px] border border-ink/10 ${a.tint} p-7 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_25px_60px_-20px_rgba(30,43,35,.3)] md:p-9`}
              style={`--d: ${i * 90}ms`}
            >
              <span class="font-display text-[clamp(1.9rem,3.2vw,2.8rem)] font-[420] leading-[1.02] text-ink">{a.title}</span>
              <span class="mt-2 text-[15px] text-ink-soft">{a.who}</span>
              <span class="mt-4 max-w-md text-[17px] leading-relaxed text-ink/80">{a.line}</span>
              <span class="mt-8 inline-flex items-center gap-2 self-start rounded-full bg-ink px-5 py-3 font-medium text-cream transition-colors group-hover:bg-persimmon-deep">
                {a.cta} <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
    <section id="check" class="px-5 pb-14 md:px-8 md:pb-20">
      <div class="mx-auto max-w-7xl">
        <LeadLeakAudit client:visible />
      </div>
    </section>
    <Season client:visible />
    <Compare client:visible />
    <Grower client:visible />
    <Stand client:visible />
    <FAQ client:visible />
    <Contact client:visible />
  </main>

  <Footer client:visible />
</RootLayout>
