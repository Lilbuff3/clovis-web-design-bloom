---
import RootLayout from '../layouts/RootLayout.astro';
import { Nav } from '../components/Chrome';
import { Hero } from '../components/Hero';
import { Harvest } from '../components/Harvest';
import { Season, Compare } from '../components/Season';
import { Grower, Stand, FAQ } from '../components/Story';
import { LeadLeakAudit } from '../components/LeadLeakAudit';
import { Contact, Footer } from '../components/Contact';
import { faqs, hasOfferCatalog, pageSchema, services, smsTo } from '../lib/data';

const agencyText = smsTo("Hi Adam! I'm with an agency and have a Figma project for you.");

const schema = pageSchema('/', {
  name: 'Custom web design, SEO & AI search marketing in Clovis, CA',
  serviceType: 'Web design and search marketing',
  audience: 'Growth-minded businesses',
  description: 'Hand-coded websites, Google Maps SEO, and AI search optimization (ChatGPT, Gemini, Claude, Perplexity) for businesses in Clovis, Fresno, and across the US.',
  offers: hasOfferCatalog.itemListElement,
}, faqs);
---

<RootLayout schema={schema} preloadImage="/images/hero.webp">
  <Nav client:load />

  <main id="main" class="relative z-10 rounded-b-[40px] shadow-[0_40px_60px_-30px_rgba(30,43,35,.35)] md:rounded-b-[72px] bg-paper">
    <Hero client:load />

    <section id="who" class="relative px-5 py-14 md:px-8 md:py-20">
      <span id="services" class="absolute -top-24 pointer-events-none" aria-hidden="true"></span>
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <h2 class="font-display h-section">
            <span class="line-mask"><span>Four services.</span></span>{" "}
            <span class="line-mask" style="--d: 120ms"><span>Buy one or all four.</span></span>
          </h2>
          <p class="reveal max-w-md text-lg leading-relaxed text-ink/80">
            Built for any business that wants more customers online — whether you need a brand-new website, stronger rankings on Google Maps and AI, or clear proof of what your marketing brings in.
          </p>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {services.map((s, i) => (
            <a
              href={s.href}
              class={`reveal group flex flex-col rounded-[28px] border border-ink/10 ${s.tint} p-7 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_25px_60px_-20px_rgba(30,43,35,.3)] md:p-8`}
              style={`--d: ${i * 80}ms`}
            >
              <span class="font-display text-[clamp(1.75rem,2.6vw,2.35rem)] font-[420] leading-[1.05] text-ink">{s.title}</span>
              <span class="mt-2 font-mono text-[12px] uppercase tracking-[.12em] text-ink-soft">{s.who}</span>
              <span class="mt-4 text-[16.5px] leading-relaxed text-ink/85">{s.what}</span>
              <span class="mt-4 border-t border-ink/15 pt-4 text-[15.5px] leading-relaxed text-ink/80">
                <strong class="font-semibold text-ink">Why it matters: </strong>{s.whyItMatters}
              </span>
              <span class="mt-auto pt-6 inline-flex items-center gap-2 self-start rounded-full bg-ink px-5 py-3 font-medium text-cream transition-colors group-hover:bg-persimmon-deep">
                {s.cta} <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          ))}
        </div>

        <div class="reveal mt-8 flex flex-col gap-3 border-t border-ink/15 pt-6 text-[16.5px] leading-relaxed text-ink/80 lg:flex-row lg:flex-wrap lg:items-center lg:justify-between">
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <strong class="font-semibold text-ink">Specialized playbooks:</strong>
            <a href="/services/local-seo-fresno/" class="inline-flex min-h-12 items-center font-medium text-ink underline decoration-persimmon decoration-2 underline-offset-4">Search, Maps &amp; AI Marketing</a>
            <span aria-hidden="true" class="text-ink-soft">·</span>
            <a href="/services/medical-web-design/" class="inline-flex min-h-12 items-center font-medium text-ink underline decoration-persimmon decoration-2 underline-offset-4">Medical &amp; Dental Practices</a>
            <span aria-hidden="true" class="text-ink-soft">·</span>
            <a href="/services/contractor-websites/" class="inline-flex min-h-12 items-center font-medium text-ink underline decoration-persimmon decoration-2 underline-offset-4">Contractors &amp; Home Services</a>
          </p>
          <p>
            Agency or designer? I also build from your Figma files, under your name.
            <a href={agencyText} class="inline-flex min-h-12 items-center font-medium text-ink underline decoration-persimmon decoration-2 underline-offset-4">Text me the project</a>
          </p>
        </div>
      </div>
    </section>

    <section id="check" class="px-5 pb-14 md:px-8 md:pb-20">
      <div class="mx-auto max-w-7xl">
        <LeadLeakAudit client:visible />
      </div>
    </section>

    <Harvest client:visible />
    <Season client:visible />
    <Compare client:visible />
    <Grower client:visible />
    <Stand client:visible />
    <FAQ client:visible />
    <Contact client:visible />
  </main>

  <Footer client:visible />
</RootLayout>
