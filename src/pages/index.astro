---
import RootLayout from '../layouts/RootLayout.astro';
import { Nav } from '../components/Chrome';
import { Hero } from '../components/Hero';
import { FourSeconds } from '../components/FourSeconds';
import { Harvest } from '../components/Harvest';
import { Season, Compare } from '../components/Season';
import { Grower, Stand, Letters, FAQ } from '../components/Story';
import { Contact, Footer } from '../components/Contact';
---

<RootLayout>
  <Nav client:load />
  
  <main class="relative z-10 rounded-b-[40px] shadow-[0_40px_60px_-30px_rgba(30,43,35,.35)] md:rounded-b-[72px] bg-paper">
    <Hero client:load />
    <FourSeconds client:visible />
    <Harvest client:visible />
    <Season client:visible />
    <Compare client:visible />
    <Grower client:visible />
    <Stand client:visible />
    <Letters client:visible />
    <FAQ client:visible />
    <Contact client:visible />
  </main>
  
  <Footer client:visible />
</RootLayout>
