---
import RootLayout from '../layouts/RootLayout.astro';
import { Nav } from '../components/Chrome';
import { Hero } from '../components/Hero';
import { Harvest } from '../components/Harvest';
import { Season, Compare } from '../components/Season';
import { Grower, Stand, FAQ } from '../components/Story';
import { LeadLeakAudit } from '../components/LeadLeakAudit';
import { Contact, Footer } from '../components/Contact';
import { faqs, hasOfferCatalog, pageSchema, smsTo } from '../lib/data';

const agencyText = smsTo("Hi Adam! I'm with an agency and have a Figma project for you.");

const schema = pageSchema('/', {
  name: 'Custom website design in Clovis, CA',
  serviceType: 'Web design',
  audience: 'Local businesses',
  description: 'Hand-coded websites for businesses in Clovis, Fresno and the Central Valley, designed, written and built by Adam.',
  offers: hasOfferCatalog.itemListElement,
}, faqs);

const audiences = [
  {
    href: '/#pricing',
    who: 'Shops · Restaurants · Auto & repair · Salons · Law & accounting · New businesses',
    title: 'Local businesses & shops',
    line: 'A custom site with your services, hours, photos and phone number — built to bring in local customers.',
    tint: 'bg-sage',
    cta: 'See packages & pricing',
  },
  {
    href: '/services/contractor-websites/',
    who: 'Roofers · HVAC · Plumbers · Dumpster rentals · Landscaping',
    title: 'Contractors & home services',
    line: 'Call and text buttons on every screen, built to load fast on two bars of signal and win local searches.',
    tint: 'bg-blush',
    cta: 'See contractor sites',
  },
  {
    href: '/services/medical-web-design/',
    who: 'Doctors · Dentists · Private clinics · Specialists',
    title: 'Medical & dental practices',
    line: 'What I build for practices where patient trust, privacy, accessibility and referrals matter most.',
    tint: 'bg-sky',
    cta: 'See medical sites',
  },
];
---

<RootLayout schema={schema}>
  <Nav client:load />

  <main id="main" class="relative z-10 rounded-b-[40px] shadow-[0_40px_60px_-30px_rgba(30,43,35,.35)] md:rounded-b-[72px] bg-paper">
    <Hero client:load />
    <Harvest client:visible />
    <section id="who" class="px-5 py-14 md:px-8 md:py-20">
      <div class="mx-auto max-w-7xl">
        <h2 class="font-display h-section">
          <span class="line-mask"><span>Built for whatever</span></span>
          <span class="line-mask" style="--d: 120ms"><span>business you run.</span></span>
        </h2>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {audiences.map((a, i) => (
            <a
              href={a.href}
              class={`reveal group flex flex-col rounded-[28px] border border-ink/10 ${a.tint} p-7 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_25px_60px_-20px_rgba(30,43,35,.3)] md:p-8`}
              style={`--d: ${i * 90}ms`}
            >
              <span class="font-display text-[clamp(1.75rem,2.6vw,2.4rem)] font-[420] leading-[1.04] text-ink">{a.title}</span>
              <span class="mt-2 text-[15px] text-ink-soft">{a.who}</span>
              <span class="mt-4 max-w-md text-[16.5px] leading-relaxed text-ink/80">{a.line}</span>
              <span class="mt-auto pt-8 inline-flex items-center gap-2 self-start rounded-full bg-ink px-5 py-3 font-medium text-cream transition-colors group-hover:bg-persimmon-deep">
                {a.cta} <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          ))}
        </div>
        <div class="reveal mt-6 flex flex-col gap-2 text-[17px] leading-relaxed text-ink/80 md:flex-row md:flex-wrap md:items-center md:justify-between">
          <p>
            Already have a site that isn't showing up on Google Maps?
            <a href="/services/local-seo-fresno/" class="inline-flex min-h-12 items-center font-medium text-ink underline decoration-persimmon decoration-2 underline-offset-4">See Fresno &amp; Clovis local SEO</a>
          </p>
          <p>
            Agency or designer? I also build from your Figma files, under your name.
            <a href={agencyText} class="inline-flex min-h-12 items-center font-medium text-ink underline decoration-persimmon decoration-2 underline-offset-4">Text me the project</a>
          </p>
        </div>
      </div>
    </section>
    <section id="check" class="px-5 pb-14 md:px-8 md:pb-20">
      <div class="mx-auto max-w-7xl">
        <LeadLeakAudit client:visible />
      </div>
    </section>
    <Season client:visible />
    <Compare client:visible />
    <Grower client:visible />
    <Stand client:visible />
    <FAQ client:visible />
    <Contact client:visible />
  </main>

  <Footer client:visible />
</RootLayout>
