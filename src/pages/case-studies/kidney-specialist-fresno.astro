---
import RootLayout from '../../layouts/RootLayout.astro';
import { Nav } from '../../components/Chrome';
import { Footer } from '../../components/Contact';
import Icon from '../../components/Icon.astro';
import { EMAIL, PHONE_DISPLAY, PHONE_TEL, cases, caseStudySchema, mailTo, smsTo } from '../../lib/data';

const c = cases.find((x) => x.caseStudyPath === '/case-studies/kidney-specialist-fresno/')!;
const textAdam = smsTo("Hi Adam, I saw the Kidney Specialist Inc. case study and I'd like to discuss a compliant website for our practice.");
const emailAdam = mailTo("Practice website inquiry");

const schema = caseStudySchema('/case-studies/kidney-specialist-fresno/', {
  title: 'Case Study: Kidney Specialist Inc. — HIPAA-Safe Practice Web Design',
  description: "How Kidney Specialist Inc. boosted provider referrals 40% with zero patient data collected online and 100/100 PageSpeed.",
  client: c.client,
  trade: c.trade,
});
---

<RootLayout
  title="Case Study: Kidney Specialist Inc. — HIPAA-Safe Practice Web Design"
  description="How Kidney Specialist Inc. boosted provider referrals 40% with zero patient data collected online and 100/100 PageSpeed. Hand-coded by Adam."
  schema={schema}
>
  <Nav client:load />

  <main id="main" class="relative z-10 bg-white text-[#151515]">
    <header class="bg-[#151515] pt-32 pb-20 md:pt-40 md:pb-24 text-white">
      <div class="mx-auto max-w-5xl px-5 md:px-8">
        <nav aria-label="Breadcrumb" class="mb-6 font-mono text-xs uppercase tracking-[.14em] text-white/70">
          <a href="/" class="underline decoration-white/30 underline-offset-4 hover:text-white">Clovis Web Design</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <a href="/#harvest" class="underline decoration-white/30 underline-offset-4 hover:text-white">Case Studies</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span class="text-white" aria-current="page">{c.client}</span>
        </nav>

        <p class="mb-3 font-mono text-xs uppercase tracking-[.18em] text-white/75 font-semibold">
          {c.trade} · {c.place} · {c.year}
        </p>

        <h1 class="font-sans text-[clamp(2.5rem,5vw,4.5rem)] font-medium tracking-[-0.045em] leading-[0.98] text-white">
          {c.headline}
        </h1>

        <p class="mt-6 text-xl leading-relaxed text-white/80 max-w-3xl">
          Medical practices cannot afford data breaches or contact forms that harvest sensitive health details into unsecured email inboxes. I built a site that holds zero patient data online.
        </p>

        <!-- Key Metrics Grid -->
        <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6 border-t border-white/15 pt-8">
          <div class="rounded-[16px] border border-white/15 bg-white/5 p-6">
            <div class="font-sans text-4xl sm:text-5xl font-medium tracking-[-0.04em] text-white">+40%</div>
            <div class="mt-2 text-sm text-white/75">Provider referrals, by Dr. Masood's count</div>
          </div>
          <div class="rounded-[16px] border border-white/15 bg-white/5 p-6">
            <div class="font-sans text-4xl sm:text-5xl font-medium tracking-[-0.04em] text-white">100/100</div>
            <div class="mt-2 text-sm text-white/75">Google PageSpeed Mobile score</div>
          </div>
          <div class="rounded-[16px] border border-white/15 bg-white/5 p-6">
            <div class="font-sans text-4xl sm:text-5xl font-medium tracking-[-0.04em] text-white">0</div>
            <div class="mt-2 text-sm text-white/75">Patient health records stored online</div>
          </div>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-5xl px-5 py-16 md:px-8 md:py-24">
      <!-- Verified Client Quote -->
      <figure class="rounded-[16px] border border-[#151515]/10 bg-[#EDEDED] p-7 md:p-8">
        <blockquote class="text-lg md:text-xl text-[#151515]/90 italic leading-relaxed">
          “{c.quote.text}”
        </blockquote>
        <figcaption class="mt-4 text-[#151515]">
          <span class="font-sans font-medium text-base">{c.quote.name}</span>
          <span class="block font-mono text-xs text-[#151515]/70">{c.quote.role}, {c.client} · <a href={c.url} target="_blank" rel="noopener noreferrer" class="underline decoration-[#151515]/40 underline-offset-4 hover:text-[#b93412]">{c.urlDisplay} ↗</a></span>
        </figcaption>
      </figure>

      <!-- Visual Showcase -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        <div class="md:col-span-6">
          <figure class="overflow-hidden rounded-[16px] border border-[#151515]/10 bg-[#EDEDED]">
            <img src={c.previewImg} alt={`${c.client} website interface on desktop`} width="1280" height="720" class="w-full object-cover" loading="lazy" decoding="async" />
            <figcaption class="p-4 border-t border-[#151515]/10 text-sm text-[#151515]/80">{c.client} custom web application.</figcaption>
          </figure>
        </div>
        <div class="md:col-span-6">
          <figure class="overflow-hidden rounded-[16px] border border-[#151515]/10 bg-[#EDEDED]">
            <img src={c.photoImg} alt={`${c.client} clinic photography in Madera and Fresno`} width={c.photoWidth} height={c.photoHeight} class="w-full object-cover" loading="lazy" decoding="async" />
            <figcaption class="p-4 border-t border-[#151515]/10 text-sm text-[#151515]/80">Clinical facilities serving Madera &amp; Fresno, CA.</figcaption>
          </figure>
        </div>
      </div>

      <!-- The Problem & What Was Built -->
      <section class="mt-16 border-t border-[#151515]/10 pt-12">
        <h2 class="font-sans text-3xl md:text-5xl font-medium tracking-[-0.04em] leading-[1.02] text-[#151515]">The Challenge</h2>
        <p class="mt-4 text-lg text-[#151515]/80 leading-relaxed max-w-3xl">
          The practice's old website used generic web forms that prompted visitors for symptoms and personal health information. Under HIPAA, transmitting and storing electronic Protected Health Information through standard web hosting exposes physicians to severe federal penalties and breach disclosures. Additionally, referring physicians had no fast way to download registration forms or verify accepted insurance plans.
        </p>

        <h2 class="mt-12 font-sans text-3xl md:text-5xl font-medium tracking-[-0.04em] leading-[1.02] text-[#151515]">What Was Built</h2>
        <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-[16px] border border-[#151515]/10 bg-[#EDEDED] p-7 text-lg text-[#151515]/85 leading-relaxed">
            <strong class="block text-[#151515] mb-1">Zero patient data architecture</strong>
            The website collects no patient health data online. Any digital booking or intake links directly to third-party HIPAA-compliant portals holding their own Business Associate Agreements (BAAs).
          </div>
          <div class="rounded-[16px] border border-[#151515]/10 bg-[#EDEDED] p-7 text-lg text-[#151515]/85 leading-relaxed">
            <strong class="block text-[#151515] mb-1">Doctor referral portal</strong>
            A dedicated page for referring physicians providing downloadable registration forms, direct fax routing, and accepted insurance lists.
          </div>
          <div class="rounded-[16px] border border-[#151515]/10 bg-[#EDEDED] p-7 text-lg text-[#151515]/85 leading-relaxed">
            <strong class="block text-[#151515] mb-1">WCAG 2.1 AA accessibility</strong>
            Engineered for older and low-vision kidney care patients with high contrast, legible typography, and full keyboard navigation.
          </div>
          <div class="rounded-[16px] border border-[#151515]/10 bg-[#EDEDED] p-7 text-lg text-[#151515]/85 leading-relaxed">
            <strong class="block text-[#151515] mb-1">Bilingual English &amp; Español</strong>
            Complete mirrored Spanish language version ensuring accessible healthcare information across the Central Valley.
          </div>
        </div>
        <p class="mt-6 text-sm text-[#151515]/70 max-w-3xl">This describes how I build websites, not legal advice. Your compliance lead or healthcare attorney has the final say.</p>
      </section>

      <!-- Closing CTA Section -->
      <section class="mt-16 rounded-[16px] bg-[#151515] p-8 md:p-12 text-center text-white">
        <h2 class="font-sans text-3xl md:text-5xl font-medium tracking-[-0.04em] leading-[1.02] text-white">Let's talk about your practice's website</h2>
        <p class="mt-4 text-lg text-white/80 max-w-2xl mx-auto leading-relaxed">
          You'll talk directly to the developer who codes your site. Tell me what your front desk gets asked most and I'll tell you how I'd build it.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4 items-center">
          <a href={`tel:${PHONE_TEL}`} class="inline-flex items-center gap-2 rounded-[8px] bg-white px-8 py-4 font-medium text-[#070707] transition hover:bg-[#FF4D1C] hover:text-white text-base">
            <Icon name="phone" /> Call me: {PHONE_DISPLAY}
          </a>
          <a href={textAdam} class="inline-flex items-center gap-2 rounded-[8px] border border-white/80 px-8 py-4 font-medium text-white transition hover:bg-white hover:text-[#070707] text-base">
            <Icon name="text" /> Text
          </a>
        </div>
        <p class="mt-4 text-sm text-white/75">Or email <a href={emailAdam} class="underline decoration-white/40 underline-offset-4 hover:text-white">{EMAIL}</a></p>
      </section>
    </div>
  </main>

  <Footer client:visible />
</RootLayout>
