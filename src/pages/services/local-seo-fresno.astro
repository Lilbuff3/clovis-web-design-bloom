---
import RootLayout from '../../layouts/RootLayout.astro';
import { Nav } from '../../components/Chrome';
import { Footer } from '../../components/Contact';
import Icon from '../../components/Icon.astro';
import { PHONE_DISPLAY, PHONE_TEL, SMS_LINK } from '../../lib/data';
---

<RootLayout
  title="Fresno Local SEO — Show Up in Google Maps"
  description="Local SEO for Fresno and Clovis businesses: show up when nearby customers search on Google and Google Maps. Fast sites that turn searches into calls."
>
  <Nav client:load />

  <main id="main" class="relative z-10 mx-auto max-w-5xl px-5 pt-32 pb-24 md:px-8 md:pt-40">
    <h1 class="font-display text-4xl text-ink md:text-6xl lg:text-7xl font-[420] leading-[0.95]">
      Local SEO in Fresno
    </h1>

    <p class="mt-6 text-xl leading-relaxed text-ink/85">
      When someone in Fresno, Clovis or Madera searches for what you do, Google shows three businesses on a map. I set up your website and your Google listing so you have the best shot at being one of them, and so the people who find you can call or text in one tap.
    </p>

    <div class="mt-8 flex flex-wrap gap-4 items-center">
      <a
        href={SMS_LINK}
        class="inline-flex items-center gap-2 rounded-full bg-persimmon-deep px-6 py-3.5 font-medium text-cream shadow transition hover:bg-ink"
      >
        <Icon name="text" /> Text me at {PHONE_DISPLAY}
      </a>
      <a
        href={`tel:${PHONE_TEL}`}
        class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 font-medium text-cream shadow transition hover:bg-ink/80"
      >
        <Icon name="phone" /> Call {PHONE_DISPLAY}
      </a>
    </div>

    <section class="mt-16 border-t border-ink/10 pt-12">
      <h2 class="font-display text-2xl md:text-4xl text-ink font-[420]">
        How Google decides who to show
      </h2>
      <p class="mt-4 text-lg text-ink/80 leading-relaxed">
        Google has to be sure what your business does and where you work. Stuffing a page with keywords doesn't do that anymore.
      </p>
      <p class="mt-4 text-lg text-ink/80 leading-relaxed">
        I give each service and each town its own page, add the behind-the-scenes details Google reads to understand a business, and make sure your website and your Google Business Profile say the same thing.
      </p>
    </section>

    <section class="mt-12 border-t border-ink/10 pt-12">
      <h2 class="font-display text-2xl md:text-4xl text-ink font-[420]">
        Results in the Central Valley
      </h2>
      <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-2xl border border-ink/10 bg-paper p-6 shadow-sm">
          <h3 class="font-display text-xl text-ink font-medium">Big Bros Dumpster Rentals</h3>
          <p class="mt-2 text-ink/80 text-sm leading-relaxed">
            Number one on Google for “dumpster rental Fresno,” ahead of the national brokers that used to take those calls.
          </p>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-paper p-6 shadow-sm">
          <h3 class="font-display text-xl text-ink font-medium">Kidney Specialist Inc.</h3>
          <p class="mt-2 text-ink/80 text-sm leading-relaxed">
            Referrals from other doctors are up more than 40%, by Dr. Masood's count, with a site that collects no patient data.
          </p>
        </div>
      </div>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        <figure class="overflow-hidden rounded-2xl border border-ink/10 bg-cream shadow-sm">
          <div class="aspect-[16/10] overflow-hidden">
            <img
              src="/images/bigbros-truck.webp"
              alt="A Big Bros roll-off dumpster in a Fresno driveway"
              class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="p-4 border-t border-ink/10">
            <p class="text-sm text-ink/80">More calls from Google meant Big Bros needed 4 more trucks.</p>
          </figcaption>
        </figure>

        <figure class="overflow-hidden rounded-2xl border border-ink/10 bg-cream shadow-sm">
          <div class="aspect-[16/10] overflow-hidden">
            <img
              src="/images/bigbros-family.webp"
              alt="William Maldonado Ramirez and the Big Bros team in Fresno, California"
              class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="p-4 border-t border-ink/10">
            <p class="text-sm text-ink/80">William and the Big Bros team, a family business in Fresno.</p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="mt-12 border-t border-ink/10 pt-12">
      <h2 class="font-display text-2xl md:text-4xl text-ink font-[420]">
        A fast site turns searches into calls
      </h2>
      <p class="mt-4 text-lg text-ink/80 leading-relaxed">
        Being first on Google doesn't help if your site is slow or hard to use. Every site I build opens fast on a phone and has call and text buttons right where thumbs land.
      </p>
    </section>
  </main>

  <Footer client:visible />
</RootLayout>
