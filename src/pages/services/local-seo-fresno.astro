---
import RootLayout from '../../layouts/RootLayout.astro';
import { Nav } from '../../components/Chrome';
import { Footer } from '../../components/Contact';
import Icon from '../../components/Icon.astro';
import { PHONE_DISPLAY, PHONE_TEL, SMS_LINK, care, cases, pageSchema, type Faq } from '../../lib/data';

const bigBros = cases[1];
const carePlus = care.find((c) => c.name === 'Care Plus')!;

const faqs: Faq[] = [
  {
    q: 'Can you guarantee a top-3 spot on Google Maps?',
    a: "No, and be careful with anyone who does. Google decides, and how close the searcher is to your business counts for a lot. What I can control is whether Google finds the same clear facts about your business everywhere it looks.",
  },
  {
    q: 'What does local SEO cost?',
    a: `Every site I build launches connected to Google Search and Maps at no extra charge. Ongoing local SEO is the ${carePlus.name} plan: ${carePlus.price} a month, cancel with one text.`,
  },
];

const schema = pageSchema('/services/local-seo-fresno/', {
  name: 'Local SEO in Fresno, CA',
  serviceType: 'Local search engine optimization',
  audience: 'Local service businesses',
  description: 'Google Business Profile setup, business schema and location pages for businesses in Fresno, Clovis and Madera.',
  offers: [{
    '@type': 'Offer',
    name: carePlus.name,
    priceCurrency: 'USD',
    priceSpecification: { '@type': 'UnitPriceSpecification', price: carePlus.price.replace('$', ''), priceCurrency: 'USD', unitText: 'MONTH' },
    description: carePlus.blurb,
  }],
}, faqs);
---

<RootLayout
  title="Fresno Local SEO & Google Maps 3-Pack Optimization"
  description="Local SEO for Fresno and Clovis businesses: Google Business Profile, business schema and town pages, so Google knows who you are and where you work. $249/month."
  schema={schema}
>
  <Nav client:load />

  <main class="relative z-10 mx-auto max-w-5xl px-5 pt-32 pb-24 md:px-8 md:pt-40">
    <div class="mb-4 font-mono text-[11px] uppercase tracking-[.2em] text-leaf">
      Local SEO · Fresno, Clovis &amp; Madera
    </div>

    <h1 class="font-display text-4xl text-ink md:text-6xl lg:text-7xl font-[420] leading-[0.95]">
      Fresno Local SEO &amp; Google Maps 3-Pack
    </h1>

    <p class="mt-6 text-xl leading-relaxed text-ink/85">
      When someone in Fresno searches for what you do, Google shows three businesses on a map before anything else. I set up your website and your Google Business Profile so Google knows exactly who you are, what you do and where you work, which is what it uses to pick those three.
    </p>

    <div class="mt-8 flex flex-wrap gap-4 items-center">
      <a href={SMS_LINK} class="inline-flex items-center gap-2 rounded-full bg-persimmon-deep px-6 py-3.5 font-medium text-cream shadow transition hover:bg-ink">
        <Icon name="text" /> Text Adam at {PHONE_DISPLAY}
      </a>
      <a href={`tel:${PHONE_TEL}`} class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 font-medium text-cream shadow transition hover:bg-ink/80">
        <Icon name="phone" /> Call {PHONE_DISPLAY}
      </a>
    </div>

    <section class="mt-16 border-t border-ink/10 pt-12">
      <h2 class="font-display text-2xl md:text-4xl text-ink font-[420]">What local SEO covers</h2>
      <ul class="mt-6 space-y-3 text-lg text-ink/85 leading-relaxed">
        <li><strong class="text-ink">Google Business Profile:</strong> the right categories, services, hours and photos, matching your website word for word.</li>
        <li><strong class="text-ink">Business schema:</strong> code on your site that gives Google your name, phone, address and service area in a format it reads directly.</li>
        <li><strong class="text-ink">Town pages:</strong> a page for each town you serve, written about the work you do there, not one page with the town name swapped.</li>
        <li><strong class="text-ink">Fast mobile pages:</strong> so a visit from Google turns into a call instead of a back-button tap.</li>
      </ul>
    </section>

    <section class="mt-12 border-t border-ink/10 pt-12">
      <h2 class="font-display text-2xl md:text-4xl text-ink font-[420]">How {bigBros.client} reached #1 for “dumpster rental Fresno”</h2>
      <p class="mt-4 text-lg text-ink/80 leading-relaxed">
        {bigBros.problem} Big Bros now ranks first on Google for “dumpster rental Fresno,” and added 4 trucks to keep up with the calls.
      </p>
      <figure class="mt-8 overflow-hidden rounded-2xl border border-ink/10 bg-cream shadow-sm md:max-w-xl">
        <div class="aspect-[16/10] overflow-hidden">
          <img src="/images/bigbros-truck.webp" alt="Big Bros roll-off dumpster truck in Fresno" class="h-full w-full object-cover" loading="lazy" decoding="async" />
        </div>
        <figcaption class="p-4 border-t border-ink/10 text-sm text-ink/80">{bigBros.client}, {bigBros.place}</figcaption>
      </figure>
    </section>

    <section class="mt-12 border-t border-ink/10 pt-12">
      <h2 class="font-display text-2xl md:text-4xl text-ink font-[420]">Questions about local SEO</h2>
      <div class="mt-8 space-y-4">
        {faqs.map((f) => (
          <details class="group rounded-2xl border border-ink/10 bg-paper p-5 transition open:bg-cream/40">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-medium text-ink">
              <span>{f.q}</span>
              <span aria-hidden="true" class="transition group-open:rotate-180">▾</span>
            </summary>
            <p class="mt-3 text-ink/80 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer client:visible />
</RootLayout>
