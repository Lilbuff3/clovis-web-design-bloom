---
import RootLayout from '../../layouts/RootLayout.astro';
import { Nav } from '../../components/Chrome';
import { Footer } from '../../components/Contact';
import Icon from '../../components/Icon.astro';
import { LeadLeakAudit } from '../../components/LeadLeakAudit';
import { PHONE_DISPLAY, PHONE_TEL, smsTo, cases, offer, pageSchema, type Faq } from '../../lib/data';

const bigBros = cases[1];

const faqs: Faq[] = [
  {
    q: 'Why does my business show up on Google Maps, but ChatGPT or Claude recommends my competitors?',
    a: 'Each AI assistant checks a different directory before naming a business. Google Gemini and AI Overviews read your Google Business Profile, but ChatGPT relies heavily on Bing Places, Yelp, and Foursquare, while Siri checks Apple Business Connect. If your profiles only exist on Google, other AI engines skip you.',
  },
  {
    q: 'Can you optimize my existing website for Google Maps and AI search without rebuilding it?',
    a: 'Yes, if your current website loads quickly on mobile and allows custom code edits. We can run a standalone Search & AI Visibility Setup to align your Google, Bing, Apple Maps, and Yelp profiles, install connected business and FAQ structured data, and wire GA4 AI lead tracking.',
  },
  {
    q: 'Why does website speed affect whether AI search engines recommend a business?',
    a: 'When a buyer asks ChatGPT, Perplexity, or Claude a live question, the AI crawler fetches candidate websites under a strict 1 to 3 second timeout. Slow WordPress templates loaded with heavy plugins frequently time out before the bot reads your page, and half of human mobile visitors leave after three seconds.',
  },
  {
    q: 'Can you guarantee a top-3 spot on Google Maps or AI answers?',
    a: 'No, and be careful with any agency that claims they can. Search engines and AI models weigh the searcher’s exact location, review history, and live competition. What I guarantee is that every directory, schema graph, and answer block they check presents clear, consistent facts about your business.',
  },
];

const schema = pageSchema('/services/local-seo-fresno/', {
  name: 'Search Engine, Google Maps & AI Search Marketing (SEO & GEO)',
  serviceType: 'Search engine and AI optimization',
  audience: 'Growth-minded businesses',
  description: 'Google Maps 3-Pack SEO, four-directory AI entity alignment (Google, Bing, Apple Maps, Yelp), business schema, and GA4 AI referral attribution.',
  offers: [offer('Search & AI Visibility Setup'), offer('Ongoing Search & AI Growth')],
}, faqs);

const aiEngines = [
  {
    engine: 'Google Search, AI Overviews & Gemini',
    directory: 'Google Business Profile & Google Maps',
    websiteSignals: 'Matching name, address, phone, and hours, dedicated service and market pages, and active review responses.',
  },
  {
    engine: 'ChatGPT & Perplexity',
    directory: 'Bing Places, Yelp & Foursquare',
    websiteSignals: 'Sub-second static HTML (<0.4s so live bots do not time out), semantic comparison tables, and clear service/pricing facts.',
  },
  {
    engine: 'Claude (Anthropic)',
    directory: 'Brave Search & Open Web Citations',
    websiteSignals: 'Direct question-and-answer sections, verified customer quotes, and consistent facts across independent directories.',
  },
  {
    engine: 'Apple Maps & Siri',
    directory: 'Apple Business Connect & Yelp',
    websiteSignals: 'Verified street address or service area, operating hours, direct tap-to-call routing, and strong Yelp ratings.',
  },
];
---

<RootLayout
  title="Search, Google Maps & AI Search Marketing (SEO & GEO) — Fresno & Clovis"
  description="Rank in the Google Maps 3-Pack and get recommended by ChatGPT, Google Gemini, Claude, Perplexity, and Siri. Four-directory alignment, business schema, and AI lead tracking."
  schema={schema}
>
  <Nav client:load currentPath={Astro.url.pathname} />

  <main id="main" class="relative z-10 bg-[#EAE6DF] text-[#141311]">
    <header class="border-b border-[#141311]/12 bg-[#DFDBD2]/60 pt-28 pb-16 md:pt-36 md:pb-20 text-[#141311]">
      <div class="mx-auto max-w-5xl px-5 md:px-8">
        <nav aria-label="Breadcrumb" class="mb-5 font-mono text-xs font-semibold uppercase tracking-[.14em] text-[#4A4742]">
          <a href="/" class="underline decoration-[#141311]/40 underline-offset-4 hover:text-[#002FA7]">Clovis Web Design</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <a href="/services/" class="underline decoration-[#141311]/40 underline-offset-4 hover:text-[#002FA7]">Services</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span class="text-[#141311]" aria-current="page">Search, Google Maps &amp; AI Marketing</span>
        </nav>
        <h1 class="font-sans text-[clamp(2.5rem,5vw,4.5rem)] font-semibold tracking-[-0.04em] leading-[0.98] text-[#141311]">
          Search, Google Maps &amp; AI Marketing
        </h1>

        <p class="mt-6 text-xl leading-relaxed text-[#4A4742] max-w-3xl">
          When a customer searches for what you do, Google shows three businesses on a map before anything else — and millions of buyers now ask ChatGPT, Google Gemini, Claude, Perplexity, or Siri who to hire. I engineer your website and align your business profiles across every directory they check so both search engines and AI assistants recommend you.
        </p>

        <div class="mt-8 flex flex-wrap gap-3.5 items-center">
          <a href={smsTo("Hi Adam, I'm interested in Search, Google Maps, and AI marketing for my business. Can we talk?")} class="inline-flex items-center gap-2 rounded-full bg-[#002FA7] px-6 py-3.5 font-semibold text-white transition hover:bg-[#141311]">
            <Icon name="text" /> Text me at {PHONE_DISPLAY}
          </a>
          <a href={`tel:${PHONE_TEL}`} class="inline-flex items-center gap-2 rounded-full border border-[#141311]/15 bg-[#F6F4EF] px-6 py-3.5 font-semibold text-[#141311] transition hover:bg-white">
            <Icon name="phone" /> Call {PHONE_DISPLAY}
          </a>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-5xl px-5 py-16 md:px-8 md:py-20">
      <section id="ai-search">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">Why AI and Google pick different businesses</h2>
        <p class="mt-4 text-lg text-[#4A4742] leading-relaxed max-w-3xl">
          Traditional search shows ten links and lets the customer compare. AI assistants only name one to three businesses — and each AI checks a different directory before trusting a company enough to recommend it. If you only set up Google, you remain invisible when buyers ask ChatGPT, Claude, or Siri.
        </p>

        <div class="mt-8 overflow-x-auto rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] shadow-[0_24px_60px_-24px_rgba(20,19,17,0.08)]">
          <table class="w-full border-collapse text-left">
            <caption class="sr-only">How Google, ChatGPT, Claude, and Siri verify and recommend businesses</caption>
            <thead>
              <tr class="border-b border-[#141311]/12 bg-[#EAE6DF]/80 text-[#141311]">
                <th scope="col" class="border-r border-[#141311]/10 p-4 font-mono text-xs font-semibold uppercase tracking-[.14em] text-[#141311]">Search / AI Engine</th>
                <th scope="col" class="border-r border-[#141311]/10 p-4 font-mono text-xs font-semibold uppercase tracking-[.14em] text-[#141311]">Primary Directory Checked</th>
                <th scope="col" class="p-4 font-mono text-xs font-semibold uppercase tracking-[.14em] text-[#002FA7]">What It Reads on Your Website</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#141311]/10 text-[15.5px] leading-relaxed">
              {aiEngines.map((row) => (
                <tr class="align-top transition-colors hover:bg-white">
                  <th scope="row" class="border-r border-[#141311]/10 p-4 font-sans text-lg font-semibold text-[#141311]">{row.engine}</th>
                  <td class="border-r border-[#141311]/10 p-4 font-semibold text-[#141311]">{row.directory}</td>
                  <td class="p-4 text-[#4A4742]">{row.websiteSignals}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-16 border-t border-[#141311]/12 pt-12">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">What Search &amp; AI Optimization covers — and why it matters</h2>
        <ul class="mt-8 divide-y divide-[#141311]/10 overflow-hidden rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] text-lg text-[#141311] leading-relaxed shadow-[0_24px_60px_-24px_rgba(20,19,17,0.08)]">
          <li class="p-6 sm:p-7">
            <strong class="font-semibold text-[#141311]">Four-Directory Profile Alignment (Google, Bing, Apple Maps &amp; Yelp):</strong> Your business categories, services, hours, and phone number matched word-for-word across all four ecosystems.
            <span class="block mt-2 text-[16px] text-[#4A4742]"><strong class="font-semibold text-[#141311]">Why it matters:</strong> When directories conflict on your hours, address, or services, AI models drop your business from their answer to avoid giving the user bad information.</span>
          </li>
          <li class="p-6 sm:p-7">
            <strong class="font-semibold text-[#141311]">Connected Business, Service &amp; FAQ Schema:</strong> Structured code on your site that feeds search engines your exact identity, service areas, offers, and common answers in a format machines read directly.
            <span class="block mt-2 text-[16px] text-[#4A4742]"><strong class="font-semibold text-[#141311]">Why it matters:</strong> Eliminates guesswork so Google Search and AI crawlers immediately verify what you sell, who you serve, and where you operate.</span>
          </li>
          <li class="p-6 sm:p-7">
            <strong class="font-semibold text-[#141311]">Fact-Dense Service Pages &amp; Direct Answer Blocks:</strong> Dedicated pages for each core service and market you serve, structured with question-based headings and concise 40–60 word answers.
            <span class="block mt-2 text-[16px] text-[#4A4742]"><strong class="font-semibold text-[#141311]">Why it matters:</strong> AI assistants quote specific facts, tables, and direct answers. Generic marketing slogans get skipped.</span>
          </li>
          <li class="p-6 sm:p-7">
            <strong class="font-semibold text-[#141311]">Sub-Second Mobile Speed (&lt;0.4s) &amp; AI Discovery Files:</strong> Hand-coded static pages paired with a machine-readable <code class="rounded bg-white px-1.5 py-0.5 font-mono text-sm border border-[#141311]/15">/llms.txt</code> index and AI agent discovery catalog.
            <span class="block mt-2 text-[16px] text-[#4A4742]"><strong class="font-semibold text-[#141311]">Why it matters:</strong> Live AI crawlers time out after 1–3 seconds on heavy WordPress templates, and human visitors tap the back button when a mobile page takes 4 seconds to open.</span>
          </li>
          <li class="p-6 sm:p-7">
            <strong class="font-semibold text-[#141311]">AI &amp; Search Lead Attribution (GA4):</strong> Custom analytics tracking that separates visits from ChatGPT, Gemini, Claude, and Perplexity from standard search traffic, alongside every phone call, text, and form lead.
            <span class="block mt-2 text-[16px] text-[#4A4742]"><strong class="font-semibold text-[#141311]">Why it matters:</strong> Shows you the exact return on your marketing investment instead of hiding AI referrals inside generic traffic reports.</span>
          </li>
        </ul>
      </section>

      <section class="mt-16 border-t border-[#141311]/12 pt-12">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">Foundational setup vs. ongoing monthly growth</h2>
        <div class="mt-8 grid divide-y divide-[#141311]/10 overflow-hidden rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] shadow-[0_24px_60px_-24px_rgba(20,19,17,0.08)] md:grid-cols-2 md:divide-x md:divide-y-0">
          <div class="p-7">
            <h3 class="font-sans text-2xl text-[#141311] font-semibold tracking-[-0.03em]">Search &amp; AI Visibility Setup</h3>
            <p class="mt-1 font-mono text-xs uppercase tracking-[.12em] text-[#002FA7] font-semibold">One-time overhaul · Standalone or paired with a build</p>
            <p class="mt-3 text-[#4A4742] leading-relaxed">
              Ideal if you already have a fast website (or are building a new one with me) and need the technical foundation done right. I align your Google Business Profile, Bing Places, Apple Business Connect, and Yelp listings, install connected business and FAQ structured data, publish your <code class="font-mono text-xs">/llms.txt</code> index, and configure GA4 call, text, and AI referral tracking.
            </p>
          </div>
          <div class="p-7">
            <h3 class="font-sans text-2xl text-[#141311] font-semibold tracking-[-0.03em]">Ongoing Search &amp; AI Growth</h3>
            <p class="mt-1 font-mono text-xs uppercase tracking-[.12em] text-[#C83E14] font-semibold">Monthly partnership · Scoped to your market &amp; ROI</p>
            <p class="mt-3 text-[#4A4742] leading-relaxed">
              For businesses expanding into new markets or competing against entrenched rivals. Includes new high-intent service and city pages each month, review generation systems, ongoing citation building across industry directories, monthly Google Maps and AI citation audits, and same-day website updates. Strictly month-to-month — cancel anytime with one text.
            </p>
          </div>
        </div>
      </section>

      <section class="mt-16 border-t border-[#141311]/12 pt-12">
        <LeadLeakAudit client:visible />
      </section>

      <section class="mt-16 border-t border-[#141311]/12 pt-12">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">Case Study: How {bigBros.client} reached #1 on Google</h2>
        <p class="mt-4 text-lg text-[#4A4742] leading-relaxed">
          {bigBros.problem} After rebuilding their site for sub-second mobile speed, dedicated market pages, and aligned Google Maps signals, Big Bros ranks #1 on Google for “dumpster rental Fresno” and added 4 trucks to keep up with incoming calls and texts.
        </p>
        <p class="mt-4">
          <a href="/case-studies/dumpster-rental-fresno/" class="inline-flex items-center gap-1.5 font-sans text-sm font-semibold text-[#141311] underline decoration-[#C83E14] decoration-2 underline-offset-4 hover:text-[#002FA7]">
            Read the full Big Bros case study →
          </a>
        </p>
        <figure class="mt-8 overflow-hidden rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] shadow-[0_20px_50px_-24px_rgba(20,19,17,0.08)] md:max-w-xl">
          <div class="aspect-[16/10] overflow-hidden">
            <img src="/images/bigbros-truck.webp" alt="Big Bros roll-off dumpster truck in Fresno" width="1067" height="730" class="h-full w-full object-cover" loading="lazy" decoding="async" />
          </div>
          <figcaption class="p-4 border-t border-[#141311]/10 text-sm font-semibold text-[#141311]">{bigBros.client}, {bigBros.place}</figcaption>
        </figure>
      </section>

      <section class="mt-16 border-t border-[#141311]/12 pt-12">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">Questions about Search, Google Maps &amp; AI Marketing</h2>
        <div class="mt-8 divide-y divide-[#141311]/10 overflow-hidden rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] shadow-[0_20px_50px_-24px_rgba(20,19,17,0.08)]">
          {faqs.map((f) => (
            <details class="group p-6 transition open:bg-white">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-sans text-lg font-semibold text-[#141311]">
                <span>{f.q}</span>
                <span aria-hidden="true" class="transition group-open:rotate-180">▾</span>
              </summary>
              <p class="mt-3 text-[#4A4742] leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="mt-16 rounded-2xl border border-[#141311]/12 bg-[#DFDBD2]/65 p-8 md:p-12 text-center text-[#141311]">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">Let's see how your business shows up across Google and AI</h2>
        <p class="mt-4 text-lg text-[#4A4742] max-w-2xl mx-auto leading-relaxed">
          Text me your business name and city. I'll check your visibility across Google Maps, ChatGPT, Gemini, and Claude, and tell you plainly what will move the needle.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3.5 items-center">
          <a href={smsTo("Hi Adam, I'd like you to check how my business shows up on Google Maps and AI search.")} class="inline-flex items-center gap-2 rounded-full bg-[#002FA7] px-8 py-4 font-semibold text-white transition hover:bg-[#141311] text-base">
            <Icon name="text" /> Text me: {PHONE_DISPLAY}
          </a>
          <a href={`tel:${PHONE_TEL}`} class="inline-flex items-center gap-2 rounded-full border border-[#141311]/15 bg-[#F6F4EF] px-8 py-4 font-semibold text-[#141311] transition hover:bg-white text-base">
            <Icon name="phone" /> Call {PHONE_DISPLAY}
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer client:visible />
</RootLayout>
