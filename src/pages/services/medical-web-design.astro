---
import RootLayout from '../../layouts/RootLayout.astro';
import { Nav } from '../../components/Chrome';
import { Footer } from '../../components/Contact';
import Icon from '../../components/Icon.astro';
import { PHONE_DISPLAY, PHONE_TEL, SMS_LINK } from '../../lib/data';

const faqs = [
  {
    q: 'Does our website need a BAA?',
    a: "A BAA (Business Associate Agreement) is for companies that handle patient information. Because your website never collects any, the site itself doesn't touch patient data. The tools that do, like your patient portal or scheduling system, are where BAAs belong. Your compliance officer or attorney should confirm what applies to your practice.",
  },
  {
    q: 'Can patients book through the system we already use?',
    a: 'Yes, if it gives you a booking link. Zocdoc, NexHealth, athenahealth and most patient portals do. I put that link where patients look for it.',
  },
  {
    q: 'Do you use accessibility widgets?',
    a: "No. Those add-on widgets don't fix the page underneath. I build the site to work with screen readers and keyboards from the start, so there's nothing to bolt on.",
  },
  {
    q: 'How long does it take, and what does it cost?',
    a: 'Most practice sites are the Flagship plan: $5,000, paid once, in about 4 to 6 weeks. You own the code and the domain from day one.',
  },
];
---

<RootLayout
  title="Websites for Medical Practices — Fresno & Clovis, CA"
  description="Websites for clinics and private practices in Fresno, Clovis and Madera. They never collect patient data, work with your existing booking tools, and are easy for every patient to read."
>
  <Nav client:load />

  <main id="main" class="relative z-10 mx-auto max-w-5xl px-5 pt-32 pb-24 md:px-8 md:pt-40">
    <h1 class="font-display text-4xl text-ink md:text-6xl lg:text-7xl font-[420] leading-[0.95]">
      Websites for medical practices
    </h1>

    <p class="mt-6 text-xl leading-relaxed text-ink/85">
      I build websites for clinics and private practices in Fresno, Clovis and Madera. They load fast, they're easy to read for every patient, and they never collect patient health information.
    </p>

    <div class="mt-8 flex flex-wrap gap-4 items-center">
      <a
        href={SMS_LINK}
        class="inline-flex items-center gap-2 rounded-full bg-persimmon-deep px-6 py-3.5 font-medium text-cream shadow transition hover:bg-ink"
      >
        <Icon name="text" /> Text me at {PHONE_DISPLAY}
      </a>
      <a
        href={`tel:${PHONE_TEL}`}
        class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 font-medium text-cream shadow transition hover:bg-ink/80"
      >
        <Icon name="phone" /> Call {PHONE_DISPLAY}
      </a>
    </div>

    <section class="mt-16 border-t border-ink/10 pt-12">
      <h2 class="font-display text-2xl md:text-4xl text-ink font-[420]">
        No patient data on your website
      </h2>
      <p class="mt-4 text-lg text-ink/80 leading-relaxed">
        A typical contact form sends whatever a patient types, symptoms included, to an ordinary email inbox. That's how health information ends up where it shouldn't be.
      </p>
      <p class="mt-4 text-lg text-ink/80 leading-relaxed">
        Your site won't have a form like that. When patients need to send details or book a visit, the button takes them to the tools you already use for that, like your patient portal or scheduling system.
      </p>
      <p class="mt-4 text-[15px] text-ink-soft leading-relaxed">
        This keeps patient information off your website. It isn't legal advice; your compliance officer or attorney has the final word.
      </p>
    </section>

    <section class="mt-12 border-t border-ink/10 pt-12">
      <h2 class="font-display text-2xl md:text-4xl text-ink font-[420]">
        Answers patients want before they call
      </h2>
      <p class="mt-4 text-lg text-ink/80 leading-relaxed">
        Most calls to the front desk ask the same few things. Do you take my insurance? Are you taking new patients? How do I book? I put those answers on your homepage, with your intake forms ready to download, so fewer people need to call just to ask.
      </p>
    </section>

    <section class="mt-12 border-t border-ink/10 pt-12">
      <h2 class="font-display text-2xl md:text-4xl text-ink font-[420]">
        Easy to read for every patient
      </h2>
      <p class="mt-4 text-lg text-ink/80 leading-relaxed">
        Large, high-contrast text for older patients. Pages that work with screen readers and without a mouse. I build this in from the start instead of adding a widget at the end.
      </p>
    </section>

    <section class="mt-12 border-t border-ink/10 pt-12">
      <h2 class="font-display text-2xl md:text-4xl text-ink font-[420]">
        Kidney Specialist Inc.
      </h2>
      <div class="mt-6 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-5">
          <img
            src="/images/kidney-preview.webp"
            alt="The Kidney Specialist Inc. website"
            class="rounded-2xl border border-ink/10 shadow-md w-full object-cover"
            width="600"
            height="380"
            loading="lazy"
          />
        </div>
        <figure class="md:col-span-7">
          <blockquote class="font-display text-lg md:text-xl text-ink/90 leading-relaxed">
            “My main concern was compliance with HIPAA, HITECH and CMIA regulations. Adam was very knowledgeable and experienced with handling these regulations. He made a professional-grade website that looked stunning while protecting the rights of my patients and protecting my practice. And our provider referrals are up over 40%!”
          </blockquote>
          <figcaption class="mt-4 text-sm text-ink/70">
            <span class="font-medium text-ink">Dr. Sheikh Mohammad Masood, MD</span> · Founding President &amp; Medical Director, Kidney Specialist Inc.
          </figcaption>
        </figure>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-3 text-ink/80">
        <li class="border-t border-ink/15 pt-3"><span class="block font-display text-3xl text-ink">+40%</span> Referrals from other doctors, by Dr. Masood's count</li>
        <li class="border-t border-ink/15 pt-3"><span class="block font-display text-3xl text-ink">100/100</span> Google PageSpeed</li>
        <li class="border-t border-ink/15 pt-3"><span class="block font-display text-3xl text-ink">0</span> Patient details collected online</li>
      </ul>
    </section>

    <section class="mt-12 border-t border-ink/10 pt-12">
      <h2 class="font-display text-2xl md:text-4xl text-ink font-[420]">
        Questions practices ask
      </h2>
      <dl class="mt-6 divide-y divide-ink/10 border-y border-ink/10">
        {faqs.map((f) => (
          <div class="py-6">
            <dt class="font-display text-xl text-ink">{f.q}</dt>
            <dd class="mt-2 max-w-3xl text-[17px] leading-relaxed text-ink/80">{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-12 border-t border-ink/10 pt-12">
      <h2 class="font-display text-2xl md:text-4xl text-ink font-[420]">
        Talk to the person who builds it
      </h2>
      <p class="mt-4 text-lg text-ink/80 leading-relaxed">
        Text or call me. You'll talk to the person who writes your site, not an account manager.
      </p>
      <div class="mt-6 flex flex-wrap gap-4 items-center">
        <a
          href={SMS_LINK}
          class="inline-flex items-center gap-2 rounded-full bg-persimmon-deep px-6 py-3.5 font-medium text-cream shadow transition hover:bg-ink"
        >
          <Icon name="text" /> Text me at {PHONE_DISPLAY}
        </a>
      </div>
    </section>
  </main>

  <Footer client:visible />
</RootLayout>
