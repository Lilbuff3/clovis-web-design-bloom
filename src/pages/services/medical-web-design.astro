---
import RootLayout from '../../layouts/RootLayout.astro';
import { Nav } from '../../components/Chrome';
import { Footer } from '../../components/Contact';
import Icon from '../../components/Icon.astro';
import { EMAIL, PHONE_DISPLAY, PHONE_TEL, cases, mailTo, offer, pageSchema, smsTo, type Faq } from '../../lib/data';

// Everything here is about the website Adam builds for a practice. Clinic-voice copy
// (insurance lists, "accepting new patients", provider bios) belongs on the client's own site.
// Written for a practice owner or manager, often at a desk where sms: links don't open: email is offered too.
const kidney = cases[0];
const textAdam = smsTo("Hi Adam, I manage a medical practice and I'd like to talk about our website.");
const emailAdam = mailTo("Our practice's website");

const faqs: Faq[] = [
  {
    q: 'Does our practice need a BAA with its web designer?',
    a: "Usually not for a site built this way, because it never receives patient information. The Business Associate Agreement belongs with the service that does: your online intake form or patient portal.",
  },
  {
    q: 'Can patients book through the scheduling system we already use?',
    a: "Yes, if it gives you a booking link or an embed, as Zocdoc, NexHealth and most patient portals do. I put it on the site. I don't build custom EHR integrations.",
  },
  {
    q: 'How is a medical practice website scoped and priced?',
    a: "Every project is scoped to your practice's locations, specialty pages, bilingual (/es/) requirements, and search visibility goals. After our first 15-minute call, I give you an upfront quote and build a working preview you can try on your phone — if you don't like it, you don't pay. You own the code and the domain from day one.",
  },
];

const schema = pageSchema('/services/medical-web-design/', {
  name: 'Medical practice web design',
  serviceType: 'Web design',
  audience: 'Medical and dental practices',
  description: 'Websites for medical and dental practices that collect no patient information online, meet WCAG 2.1 AA, and grow provider referrals and search visibility.',
  offers: [offer('Custom Website Build'), offer('Search & AI Visibility Setup')],
}, faqs);
---

<RootLayout
  title="Medical & Dental Practice Web Design — Fresno, Clovis & California"
  description="Websites and search visibility for medical and dental practices. Zero patient data collected online, built to WCAG 2.1 AA, 100/100 Google PageSpeed."
  schema={schema}
>
  <Nav client:load />

  <main id="main" class="relative z-10 bg-[#EAE6DF] text-[#141311]">
    <header class="border-b border-[#141311]/12 bg-[#DFDBD2]/60 pt-28 pb-16 md:pt-36 md:pb-20 text-[#141311]">
      <div class="mx-auto max-w-5xl px-5 md:px-8">
        <nav aria-label="Breadcrumb" class="mb-5 font-mono text-xs font-semibold uppercase tracking-[.14em] text-[#4A4742]">
          <a href="/" class="underline decoration-[#141311]/40 underline-offset-4 hover:text-[#002FA7]">Clovis Web Design</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <a href="/services/" class="underline decoration-[#141311]/40 underline-offset-4 hover:text-[#002FA7]">Services</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span class="text-[#141311]" aria-current="page">Medical practice web design</span>
        </nav>
        <h1 class="font-sans text-[clamp(2.5rem,5vw,4.5rem)] font-semibold tracking-[-0.04em] leading-[0.98] text-[#141311]">
          Medical Practice Web Design
        </h1>

        <p class="mt-6 text-xl leading-relaxed text-[#4A4742] max-w-3xl">
          I design and build websites for medical and dental practices in Fresno, Clovis, Madera, and across California. Your site answers the questions your front desk gets all day, makes it easy for other doctors to refer to you, and never holds patient information, so there's nothing on it to breach.
        </p>
        <p class="mt-4 text-lg text-[#141311] max-w-3xl">
          <strong class="font-semibold text-[#141311]">You see a working preview before you pay anything.</strong> Tell me what your practice needs and I'll give you a straight quote upfront — if a new site won't clearly earn back what it costs, I'll tell you on our first call. You own the site and the domain.
        </p>

        <div class="mt-8 flex flex-wrap gap-3.5 items-center">
          <a href={`tel:${PHONE_TEL}`} class="inline-flex items-center gap-2 rounded-full bg-[#002FA7] px-6 py-3.5 font-semibold text-white transition hover:bg-[#141311]">
            <Icon name="phone" /> Call me: {PHONE_DISPLAY}
          </a>
          <a href={textAdam} class="inline-flex items-center gap-2 rounded-full border border-[#141311]/15 bg-[#F6F4EF] px-6 py-3.5 font-semibold text-[#141311] transition hover:bg-white">
            <Icon name="text" /> Text
          </a>
        </div>
        <p class="mt-4 text-sm text-[#4A4742]">
          Available 24/7 by phone or text. Prefer email? <a href={emailAdam} class="font-semibold text-[#141311] underline decoration-[#C83E14] underline-offset-4 hover:text-[#002FA7]">{EMAIL}</a>
        </p>
      </div>
    </header>

    <div class="mx-auto max-w-5xl px-5 py-16 md:px-8 md:py-20">
      <section>
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">A website that never holds patient data</h2>
        <p class="mt-4 text-lg text-[#4A4742] leading-relaxed max-w-3xl">
          Most practice websites get into HIPAA trouble through a contact form. A patient types their symptoms into it, and the message lands in an ordinary inbox or spreadsheet. The sites I build have no forms that ask about health. Patients call or text the office, or use the intake and booking tools your practice already runs. If the website never receives patient information, a hacked or misconfigured website has none to expose.
        </p>
        <p class="mt-3 text-sm text-[#4A4742] max-w-3xl">This is how I build sites, not legal advice. Your compliance lead or attorney has the final say.</p>
        <div class="mt-8 grid divide-y divide-[#141311]/10 overflow-hidden rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] shadow-[0_24px_60px_-24px_rgba(20,19,17,0.08)] md:grid-cols-2 md:divide-x md:divide-y-0">
          <div class="p-7">
            <h3 class="font-sans text-xl text-[#141311] font-semibold tracking-[-0.025em]">Where online intake and booking go</h3>
            <p class="mt-2 text-[#4A4742] leading-relaxed">
              If you take intake forms or appointments online, the site links to the HIPAA-compliant service you already use, such as Jotform HIPAA, FormDr or your EHR's patient portal. That vendor signs the Business Associate Agreement with you, and patient information stays on its system.
            </p>
          </div>
          <div class="p-7">
            <h3 class="font-sans text-xl text-[#141311] font-semibold tracking-[-0.025em]">Privacy-safe call &amp; referral tracking</h3>
            <p class="mt-2 text-[#4A4742] leading-relaxed">
              Ad pixels can pass what a visitor looked at on your site to Facebook or Google ad networks, which can include which conditions they read about. Instead of invasive ad trackers, you get lightweight, privacy-safe analytics: you see call, booking, and doctor-referral clicks in plain numbers without tracking individual patients or sending their browsing history to ad platforms.
            </p>
          </div>
        </div>
      </section>

      <section class="mt-16 border-t border-[#141311]/12 pt-12">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">Answers to the calls your front desk gets most</h2>
        <p class="mt-4 text-lg text-[#4A4742] leading-relaxed max-w-3xl">
          Most calls to a practice ask the same three things. I put each answer on the site in plain words, so fewer of those calls reach your front desk and your staff spend that time on the patients in front of them.
        </p>
        <ul class="mt-6 space-y-3 text-lg text-[#4A4742] leading-relaxed max-w-3xl">
          <li><strong class="font-semibold text-[#141311]">Insurance:</strong> the plans you take, by name, and what to do if a plan isn't listed.</li>
          <li><strong class="font-semibold text-[#141311]">New patients:</strong> whether you're taking them, and whether they need a referral first.</li>
          <li><strong class="font-semibold text-[#141311]">Booking:</strong> your booking link or phone number, plus registration forms patients can print and fill in at home.</li>
        </ul>
      </section>

      <section class="mt-16 border-t border-[#141311]/12 pt-12">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">Make it easy for other doctors to refer to you</h2>
        <p class="mt-4 text-lg text-[#4A4742] leading-relaxed max-w-3xl">
          A referring office wants to know where to send a referral, what to include, and whether you take the patient's plan. I build a page just for them that answers all three, with printable forms, so their staff don't have to call yours to ask. Dr. Masood says referrals from other doctors are up more than 40% since his new site went live.
        </p>
      </section>

      <section class="mt-16 border-t border-[#141311]/12 pt-12">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">Accessible to every patient</h2>
        <p class="mt-4 text-lg text-[#4A4742] leading-relaxed max-w-3xl">
          Many patients are older, have low vision, or use a screen reader. I build every page to WCAG 2.1 AA, so they can read it without zooming, use it with a keyboard alone, and find the phone number without help. That matters for your liability too: website accessibility lawsuits are common in California, and the overlay widgets some sites add don't fix the page underneath. I fix the page itself.
        </p>
      </section>

      <section class="mt-16 border-t border-[#141311]/12 pt-12">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">Patient reviews, within HIPAA and FTC rules</h2>
        <p class="mt-4 text-lg text-[#4A4742] leading-relaxed max-w-3xl">
          The review request I set up goes to every patient after a visit, not only the happy ones. Asking only patients you expect to be pleased is review gating, which the FTC treats as deceptive. Replies are the other risk: confirming that a reviewer is your patient discloses health information, and HHS has fined practices for it. Every practice gets a reply template that never confirms or denies who is a patient.
        </p>
      </section>

      <section class="mt-16 border-t border-[#141311]/12 pt-12">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">Case study: {kidney.client}</h2>
        <p class="mt-2 font-mono text-xs font-semibold uppercase tracking-[.14em] text-[#4A4742]">{kidney.trade} · {kidney.place} · {kidney.year}</p>

        <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
          <div class="md:col-span-5">
            <img src={kidney.previewImg} alt={`${kidney.client} website on a desktop screen`} class="rounded-2xl border border-[#141311]/12 w-full object-cover shadow-sm" width="1280" height="720" loading="lazy" decoding="async" />
          </div>
          <div class="md:col-span-7">
            <p class="text-lg text-[#4A4742] leading-relaxed"><strong class="font-semibold text-[#141311]">The problem:</strong> {kidney.problem}</p>
            <p class="mt-4 text-lg text-[#4A4742] leading-relaxed"><strong class="font-semibold text-[#141311]">What I built:</strong></p>
            <ul class="mt-2 space-y-1.5 text-lg text-[#141311]">
              {kidney.planted.map((p) => <li>{p}</li>)}
              <li>{kidney.stack.join(', ')}</li>
            </ul>
            <dl class="mt-6 grid grid-cols-2 gap-6">
              {kidney.yields.map((y) => (
                <div class="border-t border-[#141311]/15 pt-3">
                  <dt class="text-sm font-medium text-[#4A4742]">{y.label}</dt>
                  <dd class="font-sans text-4xl font-semibold tracking-[-0.04em] text-[#141311]">{y.prefix}{y.value}{y.suffix}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>

        <figure class="mt-8 rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] p-7 md:p-8 shadow-[0_20px_50px_-24px_rgba(20,19,17,0.08)]">
          <blockquote class="text-lg text-[#141311] leading-relaxed">“{kidney.quote.text}”</blockquote>
          <figcaption class="mt-4 text-[#141311]">
            <span class="font-sans font-semibold">{kidney.quote.name}</span>
            <span class="block font-mono text-xs text-[#4A4742]">{kidney.quote.role}, {kidney.client} · <a href={kidney.url} class="underline decoration-[#141311]/40 underline-offset-4 hover:text-[#002FA7]">{kidney.urlDisplay}</a></span>
          </figcaption>
        </figure>
        <p class="mt-4">
          <a href="/case-studies/kidney-specialist-fresno/" class="inline-flex items-center gap-1.5 font-sans text-sm font-semibold text-[#141311] underline decoration-[#C83E14] decoration-2 underline-offset-4 hover:text-[#002FA7]">
            Read the full Kidney Specialist case study →
          </a>
        </p>
      </section>

      <section class="mt-16 border-t border-[#141311]/12 pt-12">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">Scoped to your practice</h2>
        <p class="mt-4 text-lg text-[#4A4742] leading-relaxed max-w-3xl">
          Every engagement includes done-for-you copywriting from a 15-minute call, a working phone preview before you pay, 90 days of free fixes after launch, and 100% code and domain ownership.
        </p>
        <div class="mt-8 grid divide-y divide-[#141311]/10 overflow-hidden rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] shadow-[0_24px_60px_-24px_rgba(20,19,17,0.08)] md:grid-cols-2 md:divide-x md:divide-y-0">
          <div class="p-7">
            <h3 class="font-sans text-2xl text-[#141311] font-semibold tracking-[-0.03em]">Single-Location Practice Build</h3>
            <p class="mt-1 font-mono text-xs uppercase tracking-[.12em] text-[#002FA7] font-semibold">Custom Website Build · Live in 3–4 weeks</p>
            <p class="mt-3 text-[#4A4742] leading-relaxed">
              Ideal for private practices, dental offices, and specialty clinics with one location. Includes custom pages, provider profiles, insurance directory, printable patient forms, full Spanish version at /es/, WCAG 2.1 AA accessibility, and privacy-safe call &amp; referral tracking.
            </p>
          </div>
          <div class="p-7">
            <h3 class="font-sans text-2xl text-[#141311] font-semibold tracking-[-0.03em]">Multi-Location &amp; Search/AI Visibility</h3>
            <p class="mt-1 font-mono text-xs uppercase tracking-[.12em] text-[#C83E14] font-semibold">Custom System + SEO &amp; AI Optimization</p>
            <p class="mt-3 text-[#4A4742] leading-relaxed">
              For multi-location groups, surgical centers, or specialty practices looking to grow referring-physician and patient volume across Google Maps, ChatGPT, and Gemini. Includes custom clinic and provider directories, four-directory profile alignment, and dedicated referral routing.
            </p>
          </div>
        </div>
      </section>

      <section class="mt-16 border-t border-[#141311]/12 pt-12">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">Questions practices ask</h2>
        <div class="mt-8 divide-y divide-[#141311]/10 overflow-hidden rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] shadow-[0_20px_50px_-24px_rgba(20,19,17,0.08)]">
          {faqs.map((f) => (
            <details class="group p-6 transition open:bg-white">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-sans text-lg font-semibold text-[#141311]">
                <span>{f.q}</span>
                <span aria-hidden="true" class="transition group-open:rotate-180">▾</span>
              </summary>
              <p class="mt-3 text-[#4A4742] leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="mt-16 rounded-2xl border border-[#141311]/12 bg-[#DFDBD2]/65 p-8 md:p-12 text-center text-[#141311]">
        <h2 class="font-sans text-3xl md:text-5xl font-semibold tracking-[-0.038em] leading-[1.02] text-[#141311]">Let's talk about your practice's website</h2>
        <p class="mt-4 text-lg text-[#4A4742] max-w-2xl mx-auto leading-relaxed">
          You'll talk to the person who builds the site, not an account manager. Tell me what your front desk gets asked most and I'll tell you what I'd put on the site.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3.5 items-center">
          <a href={`tel:${PHONE_TEL}`} class="inline-flex items-center gap-2 rounded-full bg-[#002FA7] px-8 py-4 font-semibold text-white transition hover:bg-[#141311] text-base">
            <Icon name="phone" /> Call me: {PHONE_DISPLAY}
          </a>
          <a href={textAdam} class="inline-flex items-center gap-2 rounded-full border border-[#141311]/15 bg-[#F6F4EF] px-8 py-4 font-semibold text-[#141311] transition hover:bg-white text-base">
            <Icon name="text" /> Text
          </a>
        </div>
        <p class="mt-4 text-sm text-[#4A4742]">Or email <a href={emailAdam} class="font-semibold text-[#141311] underline decoration-[#C83E14] underline-offset-4 hover:text-[#002FA7]">{EMAIL}</a></p>
      </section>
    </div>
  </main>

  <Footer client:visible />
</RootLayout>
