---
import RootLayout from '../../layouts/RootLayout.astro';
import { Nav } from '../../components/Chrome';
import { Footer } from '../../components/Contact';
import Icon from '../../components/Icon.astro';
import { FourSeconds } from '../../components/FourSeconds';
import { PHONE_DISPLAY, PHONE_TEL, SMS_LINK } from '../../lib/data';
---

<RootLayout 
  title="Contractor & Trade Websites — Clovis & Fresno, CA"
  description="Websites for roofers, HVAC, plumbers and dumpster rentals in Fresno & Clovis. Fast on a phone, with one-tap call and text."
>
  <Nav client:load />

  <main id="main" class="relative z-10 pt-32 pb-24 md:pt-40">
    <div class="mx-auto max-w-5xl px-5 md:px-8">
      <h1 class="font-display text-4xl text-ink md:text-6xl lg:text-7xl font-[420] leading-[0.95]">
        Contractor &amp; Trade Websites
      </h1>

      <p class="mt-6 text-xl leading-relaxed text-ink/85">
        Websites for roofers, HVAC techs, plumbers, electricians, landscapers and dumpster rentals. They open fast on a phone, and customers can call or text you in one tap.
      </p>

      <div class="mt-8 flex flex-wrap gap-4 items-center">
        <a 
          href={SMS_LINK}
          class="inline-flex items-center gap-2 rounded-full bg-persimmon-deep px-6 py-3.5 font-medium text-cream shadow transition hover:bg-ink"
        >
          <Icon name="text" /> Text me at {PHONE_DISPLAY}
        </a>
        <a 
          href={`tel:${PHONE_TEL}`}
          class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 font-medium text-cream shadow transition hover:bg-ink/80"
        >
          <Icon name="phone" /> Call {PHONE_DISPLAY}
        </a>
      </div>

      <section class="mt-16 border-t border-ink/10 pt-12">
        <h2 class="font-display text-2xl md:text-4xl text-ink font-[420]">
          What it did for Big Bros Dumpster Rentals
        </h2>
        <p class="mt-4 text-lg text-ink/80 leading-relaxed">
          National brokers were getting Big Bros&#39; calls and taking a cut of every rental. I built them a fast site with their prices on the page and a text-to-book button. Now they&#39;re number one on Google for “dumpster rental Fresno,” contractors and homeowners text them directly, and they bought 4 more trucks to keep up.
        </p>

        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
          <figure class="overflow-hidden rounded-2xl border border-ink/10 bg-cream shadow-sm">
            <div class="aspect-[16/10] overflow-hidden">
              <img 
                src="/images/bigbros-truck.webp" 
                alt="A Big Bros roll-off dumpster in a Fresno driveway" 
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="p-4 border-t border-ink/10">
              <p class="text-sm text-ink/80">A Big Bros dumpster dropped off in a Fresno driveway.</p>
            </figcaption>
          </figure>

          <figure class="overflow-hidden rounded-2xl border border-ink/10 bg-cream shadow-sm">
            <div class="aspect-[16/10] overflow-hidden">
              <img 
                src="/images/bigbros-family.webp" 
                alt="William Maldonado Ramirez and the Big Bros team in Fresno, California" 
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="p-4 border-t border-ink/10">
              <p class="text-sm text-ink/80">William and the Big Bros team, a family business in Fresno.</p>
            </figcaption>
          </figure>
        </div>
      </section>
    </div>

    <FourSeconds client:visible />
  </main>

  <Footer client:visible />
</RootLayout>
