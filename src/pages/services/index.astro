---
import RootLayout from "../../layouts/RootLayout.astro";
import { Nav } from "../../components/Chrome";
import { Compare } from "../../components/Season";
import { Contact, Footer } from "../../components/Contact";
import {
  PHONE_DISPLAY,
  PHONE_TEL,
  hasOfferCatalog,
  industries,
  pageSchema,
  smsTo,
  type Faq,
} from "../../lib/data";

const serviceFaqs: Faq[] = [
  {
    q: "Can I hire you for a single service, or do I need a full-service retainer?",
    a: "Every discipline is unbundled. You can hire me for a standalone custom website build, a one-time Search & AI Visibility Setup on your existing website, or an ongoing monthly growth partnership where we add and shift channels as your revenue grows.",
  },
  {
    q: "How do you handle all five disciplines without an account-management team?",
    a: "Traditional agencies split your project across five people who rarely talk to each other: a copywriter, a template designer, an SEO specialist, and an account coordinator. Because I engineer the brand copy, static code, structured schema, and analytics myself, every layer reinforces the others from day one — with zero handoff delays.",
  },
  {
    q: "Why does website engineering affect Google Maps and AI search rankings?",
    a: "When buyers ask ChatGPT, Perplexity, or Claude who to hire, live AI crawlers fetch candidate websites under a strict 1 to 3 second timeout. Slow WordPress themes overloaded with plugins frequently time out before the bot reads your page, and over half of human mobile visitors leave after three seconds.",
  },
  {
    q: "Do you build white-label websites for design studios and marketing agencies?",
    a: "Yes. If your agency has approved Figma designs and needs a senior developer to ship clean, accessible Astro, React, and TypeScript code scoring 100/100 on Google PageSpeed, I build under your brand and hit your launch deadline.",
  },
];

const schema = pageSchema(
  "/services/",
  {
    name: "Full-Lifecycle Brand, Web Engineering, SEO & AI Search Services",
    serviceType: "Digital agency and web engineering services",
    audience: "Growth-minded businesses across industries",
    description:
      "Unbundled or end-to-end brand positioning, <0.4s custom web design, Google Maps SEO, AI search optimization (GEO), and GA4 lead attribution.",
    offers: hasOfferCatalog.itemListElement,
  },
  serviceFaqs
);

const pillars = [
  {
    code: "01",
    title: "Brand Positioning & Conversion Copy",
    subtitle: "Positioning · Messaging architecture · Visual direction · Buyer copy",
    summary:
      "Clear brand positioning, visual hierarchy, and done-for-you buyer copy written from a 15-minute interview — so visitors understand within three seconds what you do and why they should call you first.",
    commercialImpact:
      "Traffic is wasted when your message sounds identical to every competitor in your city. Strong positioning turns casual visitors into high-intent inquiries before they shop around on price.",
    deliverables: [
      "15-minute founder discovery interview (zero blank questionnaires)",
      "Primary value proposition & above-the-fold conversion hook",
      "Service-by-service buyer copy answering real objections",
      "Visual direction, typography, and high-contrast color architecture",
      "Proof integration: verified customer quotes & measurable outcomes",
    ],
    ctaLabel: "Scope brand & web copy",
    ctaHref: "/packages/",
  },
  {
    code: "02",
    title: "Custom Web Design & Engineering",
    subtitle: "Sub-second static builds · 100/100 PageSpeed · WCAG 2.1 AA · Bilingual /es/",
    summary:
      "Hand-coded Astro, React, and TypeScript websites that open in under 0.4 seconds on mobile, score 100/100 on Google PageSpeed, and put tap-to-call, text, and booking right where thumbs land.",
    commercialImpact:
      "Over half of mobile visitors abandon pages that take 3–4 seconds to load, and live AI search crawlers time out on bloated templates before reading a single word.",
    deliverables: [
      "Custom mobile-first responsive engineering (<0.4s load time)",
      "Working phone preview before you pay a dollar",
      "100/100 Google Lighthouse Performance, Accessibility & SEO architecture",
      "Optional native human-written Spanish version (/es/) with hreflang routing",
      "100% client ownership of source code, domain, and hosting from day one",
    ],
    ctaLabel: "Compare website packages",
    ctaHref: "/packages/",
  },
  {
    code: "03",
    title: "Search Engine & Google Maps SEO",
    subtitle: "Google Maps 3-Pack · High-intent service & city pages · Local authority",
    summary:
      "Google Business Profile optimization, dedicated service and market pages, and review velocity workflows engineered to put your business at the top of Google Search and the Maps 3-Pack.",
    commercialImpact:
      "When a buyer searches for your service, Google displays three map listings above all organic links — capturing ready-to-hire calls without paying per click.",
    deliverables: [
      "Full Google Business Profile category, service, and Q&A optimization",
      "Dedicated high-intent service and target-city landing pages",
      "Semantic HTML hierarchy and internal authority routing",
      "Competitor gap analysis and local citation cleanup",
      "Direct review generation links and response frameworks",
    ],
    ctaLabel: "Explore Search & Maps SEO",
    ctaHref: "/services/local-seo-fresno/",
  },
  {
    code: "04",
    title: "AI Search & Answer Optimization",
    subtitle: "ChatGPT · Google Gemini · Claude · Perplexity · Apple Siri",
    summary:
      "Four-directory profile alignment across Google Business Profile, Bing Places, Apple Business Connect, and Yelp, paired with connected JSON-LD schema and fact-dense answer blocks built for AI citation.",
    commercialImpact:
      "Millions of buyers now ask AI assistants who to hire. Unlike ten blue links, AI engines name only 1 to 3 businesses — and each AI checks a different directory before trusting a company.",
    deliverables: [
      "Four-directory alignment (Google Maps, Bing Places, Apple Maps, Yelp)",
      "Connected LocalBusiness, Service, and FAQPage JSON-LD schema graph",
      "Fact-dense question-and-answer blocks structured for AI extraction",
      "Machine-readable /llms.txt and /.well-known/ai-catalog.json discovery files",
      "Before-and-after live AI citation audit across Gemini and ChatGPT",
    ],
    ctaLabel: "How AI picks businesses",
    ctaHref: "/services/local-seo-fresno/#ai-search",
  },
  {
    code: "05",
    title: "AI & Search Lead Attribution & Retention",
    subtitle: "Custom GA4 AI channels · Call & SMS tracking · Review automation",
    summary:
      "Privacy-safe analytics that track every phone call, text message, form submission, and AI referral — paired with automated review requests and follow-up flows that turn first-time buyers into repeat revenue.",
    commercialImpact:
      "Default analytics buries ChatGPT and Gemini referrals inside generic direct traffic, and slow follow-up loses warm leads. Clear attribution proves your exact return on investment.",
    deliverables: [
      "Custom Google Analytics 4 channel group isolating AI referrals",
      "Tap-to-call, SMS click, and form conversion event tracking",
      "Automated post-service review request and SMS follow-up workflows",
      "Plain-English monthly ROI reporting tied to real customer inquiries",
      "Zero creepy third-party ad pixels or bloated tracking scripts",
    ],
    ctaLabel: "Run a live AI visibility check",
    ctaHref: "/#check",
  },
];

const playbooks = [
  {
    tag: "Search & GEO Playbook",
    title: "Search, Google Maps & AI Marketing",
    body: "See the exact directory and schema signals Google Maps, ChatGPT, Gemini, Claude, and Siri verify before recommending a business.",
    href: "/services/local-seo-fresno/",
    cta: "Read the Search & AI breakdown →",
  },
  {
    tag: "Healthcare & Clinical Playbook",
    title: "Medical & Dental Practice Web Design",
    body: "Privacy-first architecture with zero online patient health data collection, frictionless physician referral routing, and 100/100 mobile speed.",
    href: "/services/medical-web-design/",
    cta: "See medical web engineering →",
  },
  {
    tag: "Commercial & Trade Playbook",
    title: "Contractor & Fleet Website Systems",
    body: "Outrank national lead brokers in Fresno, Clovis, and your target service areas with upfront pricing pages and instant tap-to-text dispatch.",
    href: "/services/contractor-websites/",
    cta: "See contractor lead systems →",
  },
];
---

<RootLayout
  title="Brand, Custom Web Engineering, Google Maps SEO & AI Search Services — Clovis Web Design"
  description="Five unbundled disciplines engineered by one senior builder: brand positioning, <0.4s custom websites, Google Maps 3-Pack SEO, AI search optimization (GEO), and GA4 lead attribution."
  schema={schema}
>
  <Nav client:load />

  <main id="main" class="relative z-10 bg-[#EAE6DF] text-[#141311]">
    <!-- 1. Sunlit Glazier Colorfield Hero -->
    <section class="border-b border-[#141311]/12 bg-[#DFDBD2]/60 px-5 pb-16 pt-28 text-[#141311] md:px-8 md:pb-20 md:pt-32">
      <div class="mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-5 font-mono text-xs font-semibold uppercase tracking-[.14em] text-[#4A4742]">
          <a href="/" class="underline decoration-[#141311]/40 underline-offset-4 hover:text-[#002FA7]">Clovis Web Design</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span class="text-[#141311]" aria-current="page">Services &amp; Capabilities</span>
        </nav>

        <div class="grid items-end gap-10 lg:grid-cols-12">
          <div class="lg:col-span-8">
            <h1 class="font-sans text-[clamp(2.35rem,4.5vw,4.25rem)] font-semibold leading-[0.98] tracking-[-0.04em] text-[#141311]">
              Five disciplines. One senior engineer. Zero agency bloat.
            </h1>
            <p class="mt-5 max-w-3xl text-lg leading-relaxed text-[#4A4742] sm:text-xl">
              Every service is engineered to do one commercial job: make sure high-intent buyers find you on Google Maps and AI search, trust your positioning within three seconds, and call or text you directly. Hire me for a single focused build or combine disciplines as you grow.
            </p>

            <div class="mt-7 flex flex-wrap items-center gap-3.5">
              <a
                href="/packages/"
                class="inline-flex items-center gap-2 rounded-full bg-[#002FA7] px-6 py-3.5 font-sans text-[15px] font-semibold text-white transition hover:bg-[#141311]"
              >
                Configure a modular package →
              </a>
              <a
                href={smsTo("Hi Adam, I'm reviewing your services page and would like to talk about my business.")}
                class="inline-flex items-center gap-2 rounded-full border border-[#141311]/15 bg-[#F6F4EF] px-6 py-3.5 font-sans text-[15px] font-semibold text-[#141311] transition hover:bg-white"
              >
                Text me at {PHONE_DISPLAY}
              </a>
              <a
                href={`tel:${PHONE_TEL}`}
                class="inline-flex min-h-12 items-center px-3 font-sans text-sm font-semibold text-[#141311] underline decoration-[#C83E14] underline-offset-4 hover:text-[#002FA7]"
              >
                Or call {PHONE_DISPLAY}
              </a>
            </div>
          </div>

          <div class="lg:col-span-4">
            <div class="rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] p-6 shadow-[0_20px_50px_-24px_rgba(20,19,17,0.08)]">
              <h2 class="font-sans text-xl font-semibold tracking-[-0.025em] text-[#141311]">Built for ambitious brands</h2>
              <p class="mt-2 text-sm leading-relaxed text-[#4A4742]">
                I bring high-converting architecture across sectors so you outpace local and regional competitors still stuck on slow agency templates.
              </p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {industries.map((ind) => (
                  <span class="rounded-md bg-[#EAE6DF] px-2.5 py-1 text-[11.5px] font-medium text-[#141311]">
                    {ind}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Comprehensive 5-Pillar Deliverable Matrix (Divided Architectural Bays, Zero Cards Inside Cards) -->
    <section id="pillars" class="bg-[#EAE6DF] px-5 py-16 text-[#141311] md:px-8 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <h2 class="h-section font-sans font-semibold tracking-[-0.038em] text-[#141311]">
            What each discipline includes — and why it drives revenue.
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-[#4A4742]">
            No mystery retainers or vague deliverables. Here is the exact engineering, copy, schema, and attribution work inside each of the five pillars.
          </p>
        </div>

        <div class="mt-10 space-y-6">
          {pillars.map((p) => (
            <article class="overflow-hidden rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] shadow-[0_24px_60px_-24px_rgba(20,19,17,0.08)]">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#141311]/10 bg-[#EAE6DF]/55 px-6 py-3">
                <span class="rounded-full bg-[#141311] px-3 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-[.12em] text-[#F6F4EF]">
                  Pillar {p.code}
                </span>
                <span class="font-mono text-xs font-medium text-[#4A4742]">
                  {p.subtitle}
                </span>
              </div>

              <div class="grid divide-y divide-[#141311]/10 lg:grid-cols-12 lg:divide-x lg:divide-y-0">
                <div class="flex flex-col justify-between p-6 sm:p-8 lg:col-span-7">
                  <div>
                    <h3 class="font-sans text-2xl font-semibold tracking-[-0.03em] text-[#141311] sm:text-3xl">
                      {p.title}
                    </h3>
                    <p class="mt-3 text-[16px] leading-relaxed text-[#141311]">
                      {p.summary}
                    </p>
                  </div>

                  <div class="mt-6 border-t border-[#141311]/10 pt-4">
                    <p class="text-[14.5px] leading-relaxed text-[#4A4742]">
                      <strong class="font-semibold text-[#C83E14]">Why it matters: </strong>
                      {p.commercialImpact}
                    </p>
                  </div>
                </div>

                <div class="flex flex-col justify-between bg-white/60 p-6 sm:p-8 lg:col-span-5">
                  <div>
                    <div class="font-mono text-[11px] font-semibold uppercase tracking-[.14em] text-[#4A4742]">
                      Included Deliverables
                    </div>
                    <ul class="mt-3.5 space-y-2.5 text-[14.5px] leading-snug text-[#141311]">
                      {p.deliverables.map((d) => (
                        <li class="flex gap-2.5">
                          <span class="mt-[1px] font-bold text-[#0B6E3F]">✓</span>
                          <span>{d}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="mt-6 border-t border-[#141311]/10 pt-4">
                    <a
                      href={p.ctaHref}
                      class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#002FA7] px-5 py-3 font-sans text-sm font-semibold text-white transition hover:bg-[#141311]"
                    >
                      {p.ctaLabel} →
                    </a>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- Specialized Industry & Search Playbooks (Divided 3-Bay Architectural Ledger) -->
        <div class="mt-16">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h3 class="font-sans text-2xl font-semibold tracking-[-0.03em] text-[#141311] sm:text-3xl">
              Deep-dive architectures by search channel and sector
            </h3>
            <a
              href="/packages/"
              class="rounded-full border border-[#141311]/15 bg-[#F6F4EF] px-4 py-2 font-sans text-xs font-semibold text-[#141311] transition hover:bg-white"
            >
              View modular packages →
            </a>
          </div>

          <div class="mt-6 grid divide-y divide-[#141311]/10 overflow-hidden rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] shadow-[0_24px_60px_-24px_rgba(20,19,17,0.08)] md:grid-cols-3 md:divide-x md:divide-y-0">
            {playbooks.map((pb) => (
              <a
                href={pb.href}
                class="group flex flex-col justify-between p-6 transition-colors hover:bg-white"
              >
                <div>
                  <h4 class="font-sans text-xl font-semibold tracking-[-0.025em] text-[#141311] group-hover:text-[#002FA7]">
                    {pb.title}
                  </h4>
                  <p class="mt-1 font-mono text-[11px] font-medium uppercase tracking-[.12em] text-[#C83E14]">{pb.tag}</p>
                  <p class="mt-2.5 text-sm leading-relaxed text-[#4A4742]">{pb.body}</p>
                </div>
                <div class="mt-6 font-sans text-sm font-semibold text-[#002FA7] group-hover:translate-x-0.5 transition-transform">
                  {pb.cta}
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Compare Section (Typical agency vs With me) -->
    <div class="border-t border-[#141311]/12 bg-[#DFDBD2]/45">
      <div class="mx-auto max-w-5xl">
        <Compare client:visible />
      </div>
    </div>

    <!-- 4. Visible FAQ Section matching serviceFaqs -->
    <section id="service-faq" class="border-t border-[#141311]/12 bg-[#EAE6DF] px-5 py-16 text-[#141311] md:px-8 md:py-20">
      <div class="mx-auto max-w-5xl">
        <h2 class="font-sans text-3xl font-semibold tracking-[-0.035em] text-[#141311] md:text-5xl">
          Common questions about unbundled services.
        </h2>

        <div class="mt-8 grid divide-y divide-[#141311]/10 overflow-hidden rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] shadow-[0_20px_50px_-24px_rgba(20,19,17,0.08)] md:grid-cols-2 md:divide-x md:divide-y-0">
          {serviceFaqs.map((f) => (
            <div class="p-6">
              <h3 class="font-sans text-lg font-semibold leading-snug text-[#141311]">{f.q}</h3>
              <p class="mt-2.5 text-[15px] leading-relaxed text-[#4A4742]">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Contact client:visible />
  <Footer client:visible />
</RootLayout>
