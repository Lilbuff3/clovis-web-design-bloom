---
import RootLayout from "../../layouts/RootLayout.astro";
import { Nav } from "../../components/Chrome";
import { Stand, FAQ } from "../../components/Story";
import { Contact, Footer } from "../../components/Contact";
import {
  PHONE_DISPLAY,
  PHONE_TEL,
  faqs,
  hasOfferCatalog,
  pageSchema,
  smsTo,
} from "../../lib/data";

const schema = pageSchema(
  "/packages/",
  {
    name: "Modular Web Design, Search & AI Growth Packages",
    serviceType: "Modular web and search marketing packages",
    audience: "Small and mid-sized businesses seeking measurable ROI",
    description:
      "Flexible 3-step modular growth packages: choose your foundation (Custom Website Build, Search & AI Visibility Setup, or Ongoing Growth), customize channels, and scale month-to-month.",
    offers: hasOfferCatalog.itemListElement,
  },
  faqs
);

const deliverableMatrix = [
  {
    category: "Brand, Copy & Web Engineering",
    rows: [
      {
        feature: "15-minute founder interview & done-for-you buyer copy",
        web: "Included",
        setup: "Answer blocks only",
        growth: "Ongoing new pages",
      },
      {
        feature: "Working phone preview before you pay a dollar",
        web: "Included",
        setup: "—",
        growth: "Included on web builds",
      },
      {
        feature: "Hand-coded static architecture (<0.4s mobile load, 100/100 PageSpeed)",
        web: "Included",
        setup: "Speed audit & tuning",
        growth: "Continuous tuning",
      },
      {
        feature: "100% client ownership of code, domain & hosting on day one",
        web: "Included",
        setup: "Included",
        growth: "Included",
      },
      {
        feature: "Bilingual English / Español (/es/) architecture",
        web: "Optional module",
        setup: "Optional module",
        growth: "Optional module",
      },
    ],
  },
  {
    category: "Search Engine (SEO) & AI Search (GEO) Visibility",
    rows: [
      {
        feature: "Four-directory profile sync (Google Maps, Bing, Apple Maps & Yelp)",
        web: "Add-on module",
        setup: "Included",
        growth: "Included + managed",
      },
      {
        feature: "Connected LocalBusiness, Service & FAQPage JSON-LD schema",
        web: "Core business schema",
        setup: "Full citation graph",
        growth: "Expanded monthly",
      },
      {
        feature: "Fact-dense Q&A sections engineered for ChatGPT, Gemini & Claude",
        web: "Core pages",
        setup: "Included",
        growth: "New topics monthly",
      },
      {
        feature: "Machine-readable /llms.txt & AI discovery endpoints",
        web: "Included",
        setup: "Included",
        growth: "Continuously updated",
      },
      {
        feature: "High-intent service, product & target-city expansion pages",
        web: "Scoped to initial build",
        setup: "Priority audit",
        growth: "Shipped every month",
      },
    ],
  },
  {
    category: "Attribution, Retention & Support",
    rows: [
      {
        feature: "Tap-to-call, SMS click & form conversion tracking",
        web: "Included",
        setup: "Included",
        growth: "Included",
      },
      {
        feature: "Custom GA4 channel isolating ChatGPT, Gemini, Claude & Maps leads",
        web: "Add-on module",
        setup: "Included",
        growth: "Included + monthly ROI report",
      },
      {
        feature: "Automated customer review requests & SMS follow-up flows",
        web: "Optional module",
        setup: "Optional module",
        growth: "Included",
      },
      {
        feature: "Post-launch engineering support & updates",
        web: "90 days free fixes",
        setup: "30-day citation re-check",
        growth: "Same-day text-me updates",
      },
    ],
  },
];
---

<RootLayout
  title="Modular Web Design, Search & AI Growth Packages — Clovis Web Design"
  description="Big-agency capabilities modularly scoped to your ROI. Choose your foundation (Custom Website Build, Search & AI Visibility Setup, or Ongoing Growth), customize channels, and scale month-to-month."
  schema={schema}
>
  <Nav client:load />

  <main id="main" class="relative z-10 bg-[#EAE6DF] text-[#141311]">
    <!-- 1. Sunlit Glazier Colorfield Hero with 01 Base -> 02 Customize -> 03 Scale Overview -->
    <section class="border-b border-[#141311]/12 bg-[#DFDBD2]/60 px-5 pb-16 pt-28 text-[#141311] md:px-8 md:pb-20 md:pt-32">
      <div class="mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-5 font-mono text-xs font-semibold uppercase tracking-[.14em] text-[#4A4742]">
          <a href="/" class="underline decoration-[#141311]/40 underline-offset-4 hover:text-[#002FA7]">Clovis Web Design</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span class="text-[#141311]" aria-current="page">Modular Growth Packages</span>
        </nav>

        <div class="max-w-4xl">
          <h1 class="font-sans text-[clamp(2.35rem,4.5vw,4.25rem)] font-semibold leading-[0.98] tracking-[-0.04em] text-[#141311]">
            Big-agency capabilities, modularly scoped to your ROI.
          </h1>
          <p class="mt-5 max-w-3xl text-lg leading-relaxed text-[#4A4742] sm:text-xl">
            You shouldn't have to sign a bloated 12-month agency retainer just to get senior web engineering, Google Maps rankings, and AI search citations. Pick your foundation, add only the channels that move the needle right now, and own 100% of your assets from day one.
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-3.5">
            <a
              href="#stand"
              class="inline-flex items-center gap-2 rounded-full bg-[#002FA7] px-6 py-3.5 font-sans text-[15px] font-semibold text-white transition hover:bg-[#141311]"
            >
              Build your package below ↓
            </a>
            <a
              href={smsTo("Hi Adam, I'm looking at your modular packages page and want to scope a project.")}
              class="inline-flex items-center gap-2 rounded-full border border-[#141311]/15 bg-[#F6F4EF] px-6 py-3.5 font-sans text-[15px] font-semibold text-[#141311] transition hover:bg-white"
            >
              Text me at {PHONE_DISPLAY}
            </a>
            <a
              href={`tel:${PHONE_TEL}`}
              class="inline-flex min-h-12 items-center px-3 font-sans text-sm font-semibold text-[#141311] underline decoration-[#C83E14] underline-offset-4 hover:text-[#002FA7]"
            >
              Or call {PHONE_DISPLAY}
            </a>
          </div>
        </div>

        <!-- 01 Base -> 02 Customize -> 03 Scale Architectural Strip -->
        <div class="mt-12 grid divide-y divide-[#141311]/10 overflow-hidden rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] shadow-[0_24px_60px_-24px_rgba(20,19,17,0.08)] sm:grid-cols-3 sm:divide-x sm:divide-y-0">
          <div class="p-6">
            <h2 class="font-sans text-xl font-semibold tracking-[-0.025em] text-[#141311]">Choose Your Foundation</h2>
            <p class="mt-1 font-mono text-[11px] font-semibold uppercase tracking-[.12em] text-[#002FA7]">Step 01 · Base</p>
            <p class="mt-2.5 text-sm leading-relaxed text-[#4A4742]">
              Start with a custom website build, a standalone Search &amp; AI Visibility Setup on your current site, or a monthly growth partnership.
            </p>
          </div>

          <div class="p-6">
            <h2 class="font-sans text-xl font-semibold tracking-[-0.025em] text-[#141311]">Customize Your Channels</h2>
            <p class="mt-1 font-mono text-[11px] font-semibold uppercase tracking-[.12em] text-[#C83E14]">Step 02 · Channels</p>
            <p class="mt-2.5 text-sm leading-relaxed text-[#4A4742]">
              Toggle high-intent SEO market pages, four-directory AI citation architecture, review automation, bilingual /es/, or GA4 attribution.
            </p>
          </div>

          <div class="p-6">
            <h2 class="font-sans text-xl font-semibold tracking-[-0.025em] text-[#141311]">Scale As You Grow</h2>
            <p class="mt-1 font-mono text-[11px] font-semibold uppercase tracking-[.12em] text-[#0B6E3F]">Step 03 · Zero Lock-In</p>
            <p class="mt-2.5 text-sm leading-relaxed text-[#4A4742]">
              Add or shift channels month-to-month as revenue compounds. Pause or adjust anytime with a single text message.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Interactive Modular Growth Package Builder -->
    <Stand client:load />

    <!-- 3. Architectural Deliverable Comparison Matrix -->
    <section id="deliverables" class="border-t border-[#141311]/12 bg-[#DFDBD2]/55 px-5 py-16 text-[#141311] md:px-8 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <h2 class="h-section font-sans font-semibold tracking-[-0.038em] text-[#141311]">
            Compare foundations side by side.
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-[#4A4742]">
            See exactly what comes standard in each foundation and which modules can be bolted on as your business grows.
          </p>
        </div>

        <div class="mt-10 overflow-x-auto rounded-2xl border border-[#141311]/12 bg-[#F6F4EF] shadow-[0_24px_60px_-24px_rgba(20,19,17,0.08)]">
          <table class="w-full min-w-[720px] border-collapse text-left">
            <caption class="sr-only">Deliverable comparison across Custom Website Build, Search and AI Visibility Setup, and Ongoing Search and AI Growth</caption>
            <thead>
              <tr class="border-b border-[#141311]/12 bg-[#EAE6DF]/80 text-[#141311]">
                <th scope="col" class="w-[40%] border-r border-[#141311]/10 p-5 font-mono text-xs font-semibold uppercase tracking-[.14em] text-[#4A4742]">
                  Deliverable / Capability
                </th>
                <th scope="col" class="w-[20%] border-r border-[#141311]/10 p-5 font-sans text-sm font-semibold text-[#141311]">
                  01 · Custom Website Build
                </th>
                <th scope="col" class="w-[20%] border-r border-[#141311]/10 p-5 font-sans text-sm font-semibold text-[#141311]">
                  02 · Search &amp; AI Setup
                </th>
                <th scope="col" class="w-[20%] bg-[#002FA7] p-5 font-sans text-sm font-semibold text-white">
                  03 · Ongoing Growth
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#141311]/10 text-[14.5px]">
              {deliverableMatrix.map((group) => (
                <>
                  <tr class="bg-[#DFDBD2]/65">
                    <th
                      colspan="4"
                      scope="colgroup"
                      class="px-5 py-3 font-mono text-xs font-semibold uppercase tracking-[.14em] text-[#141311]"
                    >
                      {group.category}
                    </th>
                  </tr>
                  {group.rows.map((r) => (
                    <tr class="transition-colors hover:bg-white">
                      <th scope="row" class="border-r border-[#141311]/10 p-4 font-sans font-semibold text-[#141311]">
                        {r.feature}
                      </th>
                      <td class="border-r border-[#141311]/10 p-4 font-mono text-xs text-[#141311]">
                        {r.web === "Included" ? (
                          <span class="inline-flex items-center gap-1.5 font-semibold text-[#0B6E3F]">✓ Included</span>
                        ) : (
                          <span class="text-[#4A4742]">{r.web}</span>
                        )}
                      </td>
                      <td class="border-r border-[#141311]/10 p-4 font-mono text-xs text-[#141311]">
                        {r.setup === "Included" ? (
                          <span class="inline-flex items-center gap-1.5 font-semibold text-[#0B6E3F]">✓ Included</span>
                        ) : (
                          <span class="text-[#4A4742]">{r.setup}</span>
                        )}
                      </td>
                      <td class="bg-white/60 p-4 font-mono text-xs font-semibold text-[#141311]">
                        {r.growth.startsWith("Included") ? (
                          <span class="inline-flex items-center gap-1.5 font-semibold text-[#0B6E3F]">✓ {r.growth}</span>
                        ) : (
                          <span>{r.growth}</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 4. FAQ Section -->
    <div class="border-t border-[#141311]/12 bg-[#EAE6DF]">
      <div class="mx-auto max-w-4xl">
        <FAQ client:visible />
      </div>
    </div>
  </main>

  <Contact client:visible />
  <Footer client:visible />
</RootLayout>
