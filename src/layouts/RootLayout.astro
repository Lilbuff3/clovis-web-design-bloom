---
import '../index.css';
import MobileActionBar from '../components/MobileActionBar.astro';
import { business } from '../lib/data';
import { INLINE_REVEAL_SCRIPT } from '../lib/hooks';
import { INLINE_ANALYTICS_SCRIPT } from '../lib/outreach-analytics';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  schema?: object;
  preloadImage?: string;
}

const {
  title = "Clovis Web Design — Custom Websites, Google Maps SEO & AI Search Marketing",
  description = "Sub-second custom websites, Google Maps 3-Pack SEO, and AI search optimization (ChatGPT, Gemini, Claude, Perplexity) for businesses in Clovis, Fresno & across the US.",
  canonicalURL = Astro.url.href,
  schema = { "@context": "https://schema.org", "@graph": [business] },
  preloadImage,
} = Astro.props;

const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="google-site-verification" content="2epFpYs14Tg9K6RcEv6Q-ovYH84rhd0_VwGEoncOWJM" />
    <meta name="google-site-verification" content="o3GJhf1cxHaDi2kwMGuH8lXb-iQllnntRh3pru_cPmM" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="describedby" href="/llms.txt" type="text/markdown" />
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
    <meta name="theme-color" content="#EAE6DF" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect x='6' y='6' width='52' height='52' fill='%23EAE6DF' stroke='%23141311' stroke-width='4'/%3E%3Crect x='10' y='10' width='22' height='44' fill='%23002FA7'/%3E%3Crect x='36' y='10' width='18' height='20' fill='%23C83E14'/%3E%3Crect x='36' y='34' width='18' height='20' fill='%23B87D1E'/%3E%3C/svg%3E" />
    
    <!-- Open Graph & Twitter Social Image Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Clovis Web Design" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://cloviswebdesign.com/images/hero.jpg" />
    <meta property="og:image:width" content="1693" />
    <meta property="og:image:height" content="929" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cloviswebdesign.com/images/hero.jpg" />
    
    <!-- Self-hosted Font & LCP Image Preloads (Zero Google Fonts links) -->
    <link rel="preload" href="/fonts/bricolage-grotesque-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    {preloadImage && <link rel="preload" href={preloadImage} as="image" type="image/webp" fetchpriority="high" />}

    <!-- Schema.org JSON-LD @graph -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

    {gaMeasurementId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${gaMeasurementId}');
        `}></script>
      </>
    )}
  </head>
  <body class="grain">
    <a href="#main" class="fixed left-3 top-3 z-[60] -translate-y-[200%] border-2 border-[#141311] bg-[#002FA7] px-5 py-3 font-medium text-[#F6F4EF] transition-transform focus:translate-y-0">Skip to content</a>
    <slot />
    <MobileActionBar />

    <script is:inline set:html={INLINE_REVEAL_SCRIPT}></script>
    <!-- Vercel Speed Insights & Web Analytics: plain-HTML install, no package needed. Skipped on localhost so local audits don't 404. -->
    <script is:inline>
      window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
      if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
        ['/_vercel/speed-insights/script.js', '/_vercel/insights/script.js'].forEach(function(src) {
          var s = document.createElement('script');
          s.defer = true;
          s.src = src;
          document.head.appendChild(s);
        });
      }
    </script>

    <!-- Lightweight Conversion & AI Referrer Event Tracking -->
    <script is:inline set:html={INLINE_ANALYTICS_SCRIPT}></script>
  </body>
</html>
