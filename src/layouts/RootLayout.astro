---
import '../index.css';
import MobileActionBar from '../components/MobileActionBar.astro';
import { schemaGraph } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
}

const {
  title = "Clovis Web Design — Websites for Independent Medical Practices · Fresno & Clovis, CA",
  description = "Websites for independent practices in Fresno, Clovis and Madera that answer patients' and referring offices' questions, and never collect patient information. Built by Adam Youssef.",
  canonicalURL = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#F7F0E3" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='28' fill='%23EE5A2F'/%3E%3Cpath d='M32 4c4 8 10 10 16 8-2 6-8 10-16 8' fill='%232E6A4C'/%3E%3C/svg%3E" />
    
    <!-- Open Graph & Twitter Social Image Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://cloviswebdesign.com/images/hero.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cloviswebdesign.com/images/hero.jpg" />
    
    <!-- Self-hosted Font Preloads (Zero Google Fonts links) -->
    <link rel="preload" href="/fonts/bricolage-grotesque-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- Schema.org JSON-LD @graph -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body class="grain">
    <slot />
    <MobileActionBar />

    <script>
      if (typeof window !== 'undefined' && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.setAttribute('data-in', '');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

        document.querySelectorAll('.reveal, .line-mask, .clip-reveal, [data-reveal]').forEach((el) => {
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
